# Railway gives the port through $PORT; the nginx image fills it in at start-up.
server {
  listen ${PORT};
  listen [::]:${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  absolute_redirect off;

  # Shared links without www go to the real address
  if ($host = southwala.com) { return 301 https://www.southwala.com$request_uri; }

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml application/xml text/plain;

  location = /healthz { access_log off; default_type text/plain; return 200 "ok"; }
  location /_astro/ { expires 1y; add_header Cache-Control "public, immutable"; }
  location ~ ^/(favicon.*|apple-touch-icon\.png|icon-.*\.png|site\.webmanifest)$ { add_header Cache-Control "no-cache"; }
  location /covers/ { expires 7d; }
  location = /feed/ { return 301 /rss.xml; }

  # Old addresses -> clean addresses (safe to keep forever)
  # Festival pages now have one permanent address each (/festivals/govardhan-puja/); the old per-year addresses redirect there.
  rewrite ^/festivals/govardhan-20[0-9][0-9]/?$ /festivals/govardhan-puja/ permanent;
  # Amavasya, Pournami, Sankashti and Pradosham: one permanent page per month (/amavasya/november/). Old dated addresses redirect there.
  rewrite ^/(amavasya|pournami|sankashti-chaturthi)/(january|february|march|april|may|june|july|august|september|october|november|december)(-[0-9]+)?-20[0-9][0-9]/?$ /$1/$2/ permanent;
  rewrite ^/pradosham/(january|february|march|april|may|june|july|august|september|october|november|december)-[0-9]+-20[0-9][0-9]/?$ /pradosham/$1/ permanent;
  # Dated articles merged into permanent pages
  rewrite ^/deepavali-2026-dates-dhanteras-naraka-chaturdashi-lakshmi-puja/?$ /festivals/deepavali/ permanent;
  rewrite ^/karthika-masam-2026-dates-deepam-and-fasting/?$ /masam/karthika/ permanent;
  rewrite ^/sharad-purnima-2026-date-timings-and-kojagari-lakshmi-puja/?$ /festivals/sharad-purnima/ permanent;
  rewrite ^/papankusha-ekadashi-2026-date-parana-time-and-story/?$ /ekadashi/papankusha-ekadashi/ permanent;
  rewrite ^/sankashti-chaturthi-october-2026-date-moonrise-and-vrat/?$ /sankashti-chaturthi/october/ permanent;
  rewrite ^/sade-sati-2026-which-rashis-are-affected/?$ /sade-sati/ permanent;
  # Ekadashi: one permanent page per name (/ekadashi/prabodhini-ekadashi/)
  rewrite ^/ekadashi/([a-z-]+-ekadashi)-(january|february|march|april|may|june|july|august|september|october|november|december)-20[0-9][0-9](-[0-9]+)?/?$ /ekadashi/$1/ permanent;
  rewrite ^/festivals/([a-z-]+)-20[0-9][0-9]/?$ /festivals/$1/ permanent;
  rewrite ^/category/ott/?$ /tv-ott/ permanent;
  rewrite ^/category/(movies|trending|news|sports|politics)/?$ /$1/ permanent;
  rewrite ^/state/ap/?$ /andhra-pradesh/ permanent;
  rewrite ^/state/ts/?$ /telangana/ permanent;
  rewrite ^/state/ka/?$ /karnataka/ permanent;
  rewrite ^/state/tn/?$ /tamil-nadu/ permanent;
  rewrite ^/state/kl/?$ /kerala/ permanent;
  rewrite ^/religion/panchangam/(.*)$ /panchangam/$1 permanent;
  rewrite ^/religion/temples/(.*)$ /temples/$1 permanent;
  rewrite ^/author/.*$ /team/ permanent;
  # Dated daily pages were merged into the evergreen Today pages
  rewrite ^/daily-horoscope(/.*)?$ /rasi-phalalu/ permanent;
  rewrite ^/daily-panchangam(/.*)?$ /panchangam/ permanent;
  rewrite ^/astrology/?$ /rasi-phalalu/ permanent;
  rewrite ^/astrology/([a-z]+)/?$ /rasi-phalalu/$1/ permanent;

  location / { try_files $uri $uri/ =404; }
  error_page 404 /404.html;
}
