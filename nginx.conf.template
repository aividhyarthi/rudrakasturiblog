# Railway gives the port through $PORT; the nginx image fills it in at start-up.
server {
  listen ${PORT};
  listen [::]:${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  absolute_redirect off;

  # Shared links without www go to the real address
  if ($host = southwala.com) { return 301 https://www.southwala.com$request_uri; }

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml application/xml text/plain;

  location = /healthz { access_log off; default_type text/plain; return 200 "ok"; }
  location /_astro/ { expires 1y; add_header Cache-Control "public, immutable"; }
  location ~ ^/(favicon.*|apple-touch-icon\.png|icon-.*\.png|site\.webmanifest)$ { add_header Cache-Control "no-cache"; }
  location /covers/ { expires 7d; }
  location = /feed/ { return 301 /rss.xml; }

  # Old addresses -> clean addresses (safe to keep forever)
  rewrite ^/category/ott/?$ /tv-ott/ permanent;
  rewrite ^/category/(movies|trending|news|sports|politics)/?$ /$1/ permanent;
  rewrite ^/state/ap/?$ /andhra-pradesh/ permanent;
  rewrite ^/state/ts/?$ /telangana/ permanent;
  rewrite ^/state/ka/?$ /karnataka/ permanent;
  rewrite ^/state/tn/?$ /tamil-nadu/ permanent;
  rewrite ^/state/kl/?$ /kerala/ permanent;
  rewrite ^/religion/panchangam/(.*)$ /panchangam/$1 permanent;
  rewrite ^/religion/temples/(.*)$ /temples/$1 permanent;
  rewrite ^/author/.*$ /team/ permanent;
  rewrite ^/astrology/?$ /rasi-phalalu/ permanent;
  rewrite ^/astrology/([a-z]+)/?$ /rasi-phalalu/$1/ permanent;

  location / { try_files $uri $uri/ =404; }
  error_page 404 /404.html;
}
