---
// Simple black line drawings, made for Southwala. No photos, so nothing to license.
const { name, size = 44 } = Astro.props as { name: 'gopuram' | 'sun' | 'moon' | 'diya' | 'lotus' | 'ballot' | 'stars' | 'scroll' | 'film' | 'tv' | 'newspaper' | 'trophy' | 'flame'; size?: number };
---
<svg width={size} height={size} viewBox="0 0 120 120" fill="none" stroke="#000" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'gopuram' && (<>
    <path d="M10 108h100M20 108V92h80v16M28 92V78h64v14M36 78V64h48v14M44 64V50h32v14M51 50V38h18v12M60 38V22M54 22h12M60 22l0-8" />
    <path d="M52 108V96h16v12M58 70h4M58 84h4" />
    <circle cx="60" cy="12" r="3" />
  </>)}
  {name === 'sun' && (<>
    <circle cx="60" cy="60" r="22" />
    <path d="M60 14v14M60 92v14M14 60h14M92 60h14M27 27l10 10M83 83l10 10M93 27L83 37M37 83L27 93" />
  </>)}
  {name === 'moon' && (<>
    <path d="M78 24a38 38 0 1 0 22 56A32 32 0 0 1 78 24z" />
    <path d="M96 30l2 5 5 2-5 2-2 5-2-5-5-2 5-2zM104 58l1 3 3 1-3 1-1 3-1-3-3-1 3-1z" />
  </>)}
  {name === 'diya' && (<>
    <path d="M18 70c0 20 18 30 42 30s42-10 42-30z" />
    <path d="M60 22c-10 12-10 22 0 30 10-8 10-18 0-30z" />
    <path d="M40 106h40" />
  </>)}
  {name === 'lotus' && (<>
    <path d="M60 22c-14 14-14 40 0 58 14-18 14-44 0-58z" />
    <path d="M60 80C40 74 26 56 26 36c18 2 30 16 34 44z" />
    <path d="M60 80c20-6 34-24 34-44-18 2-30 16-34 44z" />
    <path d="M18 94c14-10 30-14 42-14s28 4 42 14M30 104h60" />
  </>)}
  {name === 'ballot' && (<>
    <path d="M22 54h76v52H22zM42 54V40h36v14" />
    <path d="M48 70h24" />
    <path d="M44 22l32-4 2 20-32 4z" />
  </>)}
  {name === 'stars' && (<>
    <circle cx="60" cy="60" r="38" />
    <path d="M60 30l7 20 21 1-17 12 6 21-17-12-17 12 6-21-17-12 21-1z" />
  </>)}
  {name === 'scroll' && (<>
    <path d="M30 24h60v70a10 10 0 0 1-10 10H40a10 10 0 0 1-10-10zM40 40h40M40 54h40M40 68h28" />
    <path d="M30 24a10 10 0 1 0-10 10" />
  </>)}
  {name === 'film' && (<>
    <path d="M16 52h88v52H16zM16 52l10-22h20L36 52M42 52l10-22h20L62 52M68 52l10-22h20L88 52" />
    <path d="M52 70l22 12-22 12z" />
  </>)}
  {name === 'tv' && (<>
    <rect x="14" y="32" width="92" height="62" rx="6" />
    <path d="M40 106h40M48 94v12M72 94v12M48 18l12 14 12-14M52 62l20 10-20 10z" />
  </>)}
  {name === 'newspaper' && (<>
    <path d="M20 28h66v72H26a6 6 0 0 1-6-6zM86 46h14v48a6 6 0 0 1-6 6" />
    <path d="M30 42h46M30 56h46M30 70h30M30 84h30" />
  </>)}
  {name === 'trophy' && (<>
    <path d="M40 22h40v26a20 20 0 0 1-40 0zM40 30H22v6a16 16 0 0 0 18 16M80 30h18v6a16 16 0 0 1-18 16M60 70v18M44 100h32M50 88h20" />
  </>)}
  {name === 'flame' && (<>
    <path d="M60 12c8 18 28 30 28 56a28 28 0 0 1-56 0c0-14 8-20 14-30 4 8 6 10 10 12 4-12 2-24 4-38z" />
    <path d="M60 72c6 8 10 12 10 18a10 10 0 0 1-20 0c0-6 4-10 10-18z" />
  </>)}
</svg>
