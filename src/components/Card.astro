---
import { categoryLabel, fmtDate, type Article } from '../lib/articles';
const { a } = Astro.props as { a: Article };
---
<a class="item" href={`/${a.slug}/`}>
  <div class="kicker">{categoryLabel(a.data.category)}</div>
  <h3>{a.data.title}</h3>
  <p>{a.data.description}</p>
  <div class="meta" style="margin-top:4px">{a.data.author} · {fmtDate(a.data.date)}{a.data.draft ? ' · DRAFT' : ''}</div>
</a>
