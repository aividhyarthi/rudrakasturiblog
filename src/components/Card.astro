---
import StoryImg from './StoryImg.astro';
import { categoryLabel, fmtDate, byline, type Article } from '../lib/articles';
const { a, big = true } = Astro.props as { a: Article; big?: boolean };
---
<a class={`card c-${a.data.category}`} href={`/${a.slug}/`}>
  <div class="imgwrap"><StoryImg slug={a.slug} alt={a.data.imageAlt ?? a.data.title} /></div>
  <span class="kicker">{categoryLabel(a.data.category)}</span>
  <h3>{a.data.title}</h3>
  {big && <p>{a.data.description}</p>}
  <div class="meta">{byline(a.data)} · {fmtDate(a.data.date)}{a.data.draft ? ' · DRAFT' : ''}</div>
</a>
