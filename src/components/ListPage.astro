---
import Base from '../layouts/Base.astro';
import Card from './Card.astro';
import Sidebar from './Sidebar.astro';
import { allArticles } from '../lib/articles';
const { title, blurb, filter, active, description } = Astro.props as { title: string; blurb: string; filter: (a: any) => boolean; active?: string; description?: string };
const items = (await allArticles()).filter(filter);
---
<Base title={title} description={description ?? blurb} active={active}>
  <div class="art">
    <div>
      <div class="sechead"><h2>{title}</h2></div>
      <p class="meta" style="font-size:15px;margin:-4px 0 16px">{blurb}</p>
      {items.length ? <div>{items.map((a) => <Card a={a} />)}</div> : <div class="empty">Nothing here yet. Check back soon.</div>}
    </div>
    <Sidebar />
  </div>
</Base>
