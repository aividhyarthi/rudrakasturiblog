---
// "Today is Karthika Masam" (or whichever month is running): what the month is, why it matters, what today is for, and the dates ahead.
import { masaOn, masaStartingSoon } from '../lib/masa';
import { MASA_TEXT } from '../data/masa';
import { festivalsByKey } from '../lib/festivals';
import { masaDateRows } from '../lib/masadates';
import { allArticles } from '../lib/articles';
import { linkExists } from '../lib/fmt';
import { ymdKey, WEEKDAYS } from '../lib/panchang';
import { EN_MONTH_NAMES } from '../lib/lunar';
const { ymd, compact = false } = Astro.props as { ymd: { y: number; m: number; d: number }; compact?: boolean };
const here = masaOn(ymd);
const soon = masaStartingSoon(ymd, 3);
const hasText = (x: { name: string; adhika: boolean }) => !!MASA_TEXT[x.name] && !x.adhika;
const tomorrow = soon && soon.inDays <= 1 && hasText(soon.masa) ? soon : null; // on the last day of a month, say the next month begins tomorrow
const live = !tomorrow && hasText(here) ? here : null;
const next = tomorrow ?? (!live && soon && hasText(soon.masa) ? soon : null);
const m = live ?? next?.masa ?? null;
const text = m ? MASA_TEXT[m.name] : null;
const nice = (x: { y: number; m: number; d: number }) => `${x.d} ${EN_MONTH_NAMES[x.m - 1]}`;
const wdOf = (x: { y: number; m: number; d: number }) => WEEKDAYS[new Date(Date.UTC(x.y, x.m - 1, x.d)).getUTCDay()];
const published = new Set((await allArticles()).map((a) => a.slug));
const bannerLinks = (text?.links ?? []).filter((l) => linkExists(l.href, published));
const dates = m && text ? masaDateRows(m, ymdKey(ymd)).slice(0, compact ? 5 : 9) : [];
const todayFest = festivalsByKey().get(ymdKey(ymd)) ?? [];
const wd = new Date(Date.UTC(ymd.y, ymd.m - 1, ymd.d)).getUTCDay();
const status = live ? `Day ${here.dayNo} of ${here.total}` : next ? (next.inDays === 1 ? `Begins tomorrow, ${wdOf(next.masa.start)} ${nice(next.masa.start)}` : `Begins in ${next.inDays} days, ${nice(next.masa.start)}`) : '';
---
{m && text && (
  <section class={compact ? 'masa masa-compact' : 'masa'} aria-label={text.show}>
    <div class="wrap">
      <div class="masa-head">
        <span class="masa-kicker">{live ? 'This month' : 'Coming up'}</span>
        <h2>{live ? `Today is ${text.show}` : `${text.show} begins ${next!.inDays === 1 ? 'tomorrow' : `in ${next!.inDays} days`}`} <span class="te">{text.te}</span></h2>
        <p class="masa-tag">{text.tagline}. <b>{status}</b> · {nice(m.start)} to {nice(m.end)}, {m.end.y}</p>
      </div>
      <div class="masa-body">
        <div>
          {!compact && text.why.map((p) => <p>{p}</p>)}
          <div class="masa-today">
            <b>{live ? 'What today is for' : 'Tonight'}</b>
            <p>{live ? text.doToday[wd] : text.before}</p>
            {live && <p class="masa-every">{text.every}</p>}
            {todayFest.length > 0 && <p>{todayFest.map((f) => <a href={`/festivals/${f.slug}/`}><b>Today: {f.name}</b></a>)}</p>}
          </div>
          <div class="masa-links">{bannerLinks.slice(0, compact ? 3 : 5).map((l) => <a href={l.href}>{l.label}</a>)}</div>
        </div>
        <div>
          <b class="masa-h">Dates to keep</b>
          <ul class="masa-dates">{dates.map((d) => <li><a href={d.href}><span>{d.label}</span><small>{d.date}</small></a></li>)}</ul>
          {!compact && <><b class="masa-h">What families do this month</b><ul class="masa-facts">{text.facts.map((f) => <li>{f}</li>)}</ul></>}
        </div>
      </div>
    </div>
  </section>
)}
