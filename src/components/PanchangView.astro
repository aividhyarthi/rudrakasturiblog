---
import { CITIES, panchangFor, fmtTime, WEEKDAYS, WEEKDAYS_TE, ymdKey, addDays, todayIST, type CityId } from '../lib/panchang';
import { RASHIS } from '../lib/astro';
import { guidance } from '../lib/muhurta';
import CalendarCta from './CalendarCta.astro';
import { festivalsByKey, upcomingFestivals } from '../lib/festivals';
const { city, ymd } = Astro.props as { city: CityId; ymd: { y: number; m: number; d: number } };
const p = panchangFor(ymd, city);
const c = CITIES[city];
const ref = new Date(Date.UTC(ymd.y, ymd.m - 1, ymd.d));
const t = (d: Date) => fmtTime(d, ref);
const range = (r: { start: Date; end: Date }) => `${t(r.start)} to ${t(r.end)}`;
const seg = (s: { paksha?: string; name: string; te?: string }) =>
  `${s.paksha ? s.paksha + ' ' : ''}${s.name}`;
const segTe = (s: { paksha?: string; te?: string }) => (s.te ? `${s.paksha === 'Shukla' ? 'శుక్ల ' : s.paksha === 'Krishna' ? 'కృష్ణ ' : ''}${s.te}` : '');
const todayFest = festivalsByKey().get(ymdKey(ymd)) ?? [];
const nextFest = upcomingFestivals(addDays(ymd, 1), 4);
const g = guidance(p.nakshatra[0].name, p.tithi[0].name, p.weekday);
const dName = WEEKDAYS[p.weekday], dPretty = `${ymd.d} ${['January','February','March','April','May','June','July','August','September','October','November','December'][ymd.m - 1]} ${ymd.y}`;
const t0 = p.tithi[0], n0 = p.nakshatra[0];
const answer = `On ${dName}, ${dPretty}, the tithi in ${c.name} is ${t0.paksha} ${t0.name} until ${t(t0.endsAt)}, the nakshatra is ${n0.name} until ${t(n0.endsAt)}, sunrise is ${t(p.sunrise)} and sunset ${t(p.sunset)}. Rahu Kalam is ${range(p.rahu)}${p.amrit.length ? ` and Amrit Kalam is ${p.amrit.map(range).join(' and ')}` : ''}.`;
const answerTe = `${c.name} నేటి పంచాంగం: తిథి ${t0.paksha === 'Shukla' ? 'శుక్ల' : 'కృష్ణ'} ${t0.te ?? ''}, నక్షత్రం ${n0.te ?? n0.name}, రాహుకాలం ${range(p.rahu)}.`;
const qa: [string, string][] = [
  [`What is today's tithi in ${c.name}?`, `${t0.paksha} ${t0.name} until ${t(t0.endsAt)}${p.tithi[1] ? `, then ${p.tithi[1].paksha} ${p.tithi[1].name}` : ''}.`],
  [`What is Rahu Kalam today in ${c.name}?`, `Rahu Kalam on ${dName} in ${c.name} is ${range(p.rahu)}. Avoid starting new work in this window.`],
  [`What is today's nakshatra?`, `${n0.name} until ${t(n0.endsAt)}${p.nakshatra[1] ? `, then ${p.nakshatra[1].name}` : ''}.`],
  [`What is Amrit Kalam (Amrita Ghadiya) today?`, p.amrit.length ? `${p.amrit.map(range).join(' and ')}. It is a good window to begin anything auspicious.` : 'There is no Amrit Kalam within this day.'],
  [`What time is Varjyam today?`, p.varjyam.length ? `${p.varjyam.map(range).join(' and ')}. It is traditionally avoided for new beginnings.` : 'There is no Varjyam within this day.'],
  [`What time are sunrise and sunset in ${c.name} today?`, `Sunrise is ${t(p.sunrise)} and sunset is ${t(p.sunset)}.`],
  [`Is today good for travel or joining a new job?`, `${g.rows[0].text} For a new job: ${g.rows[1].text}`],
  ...(todayFest.length ? [[`Which festival is today?`, `${todayFest.map((f) => f.name).join(' and ')}.`] as [string, string]] : []),
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: qa.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
const prev = ymdKey(addDays(ymd, -1)), next = ymdKey(addDays(ymd, 1));
const tdy = todayIST();
const offset = Math.round((Date.UTC(ymd.y, ymd.m - 1, ymd.d) - Date.UTC(tdy.y, tdy.m - 1, tdy.d)) / 86400000);
const hasPrev = offset > -2, hasNext = offset < 45;
// timeline (00:00 to 24:00 IST)
const dayStart = Date.UTC(ymd.y, ymd.m - 1, ymd.d) - 5.5 * 3600 * 1000;
const pos = (d: Date) => Math.max(0, Math.min(100, ((d.getTime() - dayStart) / 86400000) * 100));
const seg2 = (r: { start: Date; end: Date }, color: string, label: string, lane: string) => ({ left: pos(r.start), width: Math.max(0.8, pos(r.end) - pos(r.start)), color, label, lane });
const segs = [
  seg2(p.brahma, '#5b8cff', 'Brahma Muhurtham', 'g'), seg2(p.abhijit, '#2fa866', 'Abhijit', 'g'), ...p.amrit.map((r) => seg2(r, '#1f9d8f', 'Amrit Kalam', 'g')), ...p.varjyam.map((r) => seg2(r, '#b0397a', 'Varjyam', 'b')),
  seg2(p.rahu, '#d6382c', 'Rahu Kalam', 'b'), seg2(p.yama, '#f08a24', 'Yamagandam', 'b'), seg2(p.gulika, '#8a8a94', 'Gulika', 'b'),
];
---
<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
<p class="answer"><b>{answer}</b></p>
<p class="answer te">{answerTe}</p>
<div class="pgrid">
  <div class="pcard"><b>Sunrise</b><span>{t(p.sunrise)}</span></div>
  <div class="pcard"><b>Sunset</b><span>{t(p.sunset)}</span></div>
  {p.moonrise && <div class="pcard"><b>Moonrise</b><span>{t(p.moonrise)}</span></div>}
  {p.moonset && <div class="pcard"><b>Moonset</b><span>{t(p.moonset)}</span></div>}
</div>

{todayFest.length > 0 && <div class="fest-today">{todayFest.map((f) => <a href={`/festivals/${f.slug}/`}><b>Today: {f.name}</b><span>{f.alt ?? f.god}</span></a>)}</div>}
<div class="fest-next"><b>Festivals coming up</b>{nextFest.map((f) => <a href={`/festivals/${f.slug}/`}>{f.name}<small>{WEEKDAYS[f.weekday].slice(0, 3)}, {f.ymd.d} {['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][f.ymd.m - 1]}</small></a>)}<a href="/festivals/">All festivals</a></div>
<CalendarCta />

<div class="sect"><h2>Your day at a glance</h2></div>
<div class="tl">
  <div class="tl-bar" role="img" aria-label="Timeline of the day showing good and avoid periods">
    <div class="tl-day" style={`left:${pos(p.sunrise)}%;width:${pos(p.sunset) - pos(p.sunrise)}%`}></div>
    {segs.map((s) => <div class={`tl-seg ${s.lane}`} title={s.label} style={`left:${s.left}%;width:${s.width}%;background:${s.color}`}></div>)}
  </div>
  <div class="tl-ticks"><span>12 AM</span><span>6 AM</span><span>12 PM</span><span>6 PM</span><span>12 AM</span></div>
  <div class="tl-legend">{segs.map((s) => <span><i style={`background:${s.color}`}></i>{s.label}</span>)}<span><i style="background:#fbd38d"></i>Daylight</span></div>
</div>

<div class="timing">
  <div class="good"><b>Good timings (manchi samayam)</b>
    <span>{range(p.abhijit)}</span><small>Abhijit Muhurtham: traditionally auspicious for starting work.</small>
    <span style="display:block;margin-top:14px">{range(p.brahma)}</span><small>Brahma Muhurtham: traditionally for prayer, study and meditation.</small>
    {p.amrit.map((r) => <><span style="display:block;margin-top:14px">{range(r)}</span><small>Amrit Kalam (Amrita Ghadiya): a nectar-like window of about 1.5 hours, good for beginning anything auspicious.</small></>)}
  </div>
  <div class="bad"><b>Timings to avoid</b>
    <span>{range(p.rahu)}</span><small>Rahu Kalam: avoid starting new work or travel.</small>
    {p.varjyam.map((r) => <><span style="display:block;margin-top:14px;font-size:18px">Varjyam {range(r)}</span><small>Varjyam (Tyajyam): avoid starting anything important.</small></>)}
    <span style="display:block;margin-top:14px;font-size:18px">Yamagandam {range(p.yama)}</span>
    <span style="display:block;margin-top:8px;font-size:18px">Gulika {range(p.gulika)}</span>
  </div>
</div>

<div class="sect"><h2>Good for today: travel, a new job, a fresh start</h2></div>
<div class="gfor">
  {g.rows.map((r) => <div class={`gf ${r.v}`}><b>{r.what}</b><em>{r.v === 'good' ? 'Good' : r.v === 'avoid' ? 'Avoid' : 'Fine'}</em><small>{r.text}</small></div>)}
</div>
<p class="disc">{g.note} These are traditional rules of thumb from the nakshatra and tithi; for a wedding, griha pravesham or a major start, please also ask your family priest.</p>

<div class="sect"><h2>The five limbs (Panchangam)</h2></div>
<div class="limbs">
  <div class="limb"><b>Tithi</b>{p.tithi.map((s) => <div class="v">{seg(s)} <span class="te">{segTe(s)}</span><small>until {t(s.endsAt)}</small></div>)}</div>
  <div class="limb"><b>Nakshatra</b>{p.nakshatra.map((s) => <div class="v">{s.name} <span class="te">{s.te}</span><small>until {t(s.endsAt)}</small></div>)}</div>
  <div class="limb"><b>Yoga</b>{p.yoga.map((s) => <div class="v">{s.name}<small>until {t(s.endsAt)}</small></div>)}</div>
  <div class="limb"><b>Karana</b>{p.karana.map((s) => <div class="v">{s.name}<small>until {t(s.endsAt)}</small></div>)}</div>
  <div class="limb"><b>Vara (weekday)</b><div class="v">{WEEKDAYS[p.weekday]} <span class="te">{WEEKDAYS_TE[p.weekday]}</span></div></div>
  <div class="limb"><b>Moon sign today</b><div class="v">{RASHIS[p.moonSign].skt} <span class="te">{RASHIS[p.moonSign].te}</span><small>{RASHIS[p.moonSign].en}</small></div></div>
</div>

<p class="disc">Calculated for {c.name}, {c.state}, from astronomical positions of the Sun and Moon (Lahiri ayanamsa, local sunrise). Places a few hundred kilometres away differ by a few minutes. Traditions vary by region and family: for rituals, weddings and muhurthams, please confirm with your family priest or temple.</p>
<div class="chips">{hasPrev && <a href={`/panchangam/${city}/${prev}/`}>&larr; Previous day</a>}{hasNext && <a href={`/panchangam/${city}/${next}/`}>Next day &rarr;</a>}</div>

<div class="sect" style="margin-top:26px"><h2>Quick answers</h2></div>
{qa.map(([q, a]) => <><h3 style="margin-bottom:2px">{q}</h3><p style="margin-top:0">{a}</p></>)}
