---
import Hero from '../components/Hero.astro';
import Glyph from './Glyph.astro';
import Base from '../layouts/Base.astro';
import { RASHIS, reading } from '../lib/astro';
import { todayIST, addDays, NAKSHATRAS_TE } from '../lib/panchang';
import { dayFacts } from '../lib/daily';
const { i, span } = Astro.props as { i: number; span: 'daily' | 'weekly' | 'monthly' | 'tomorrow' };
const r = RASHIS[i];
const today = todayIST();
const M = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const fd = (x: { y: number; m: number; d: number }) => `${x.d} ${M[x.m - 1]} ${x.y}`;
const days = span === 'daily' || span === 'tomorrow' ? 0 : span === 'weekly' ? 6 : 29;
const start = span === 'tomorrow' ? addDays(today, 1) : today;
const d = reading(i, start, span === 'tomorrow' ? 'daily' : span);
const range = days === 0 ? fd(start) : `${fd(today)} to ${fd(addDays(today, days))}`;
const star = (n: number) => '★'.repeat(n) + '☆'.repeat(5 - n);
const bandStars: Record<string, number> = { challenging: 2, mixed: 3, good: 4, excellent: 5 };
const label = { daily: 'Today', weekly: 'This week', monthly: 'This month', tomorrow: 'Tomorrow' }[span];
const titles = {
  daily: `${r.skt} Rasi Phalalu Today (${r.te} నేటి రాశి ఫలాలు), ${start.d} ${M[start.m - 1].slice(0, 3)} ${start.y}`,
  weekly: `${r.skt} Rasi Weekly Horoscope (${r.te} వారఫలాలు), ${today.d}-${addDays(today, 6).d} ${M[addDays(today, 6).m - 1].slice(0, 3)} ${today.y}`,
  monthly: `${r.skt} Rasi Monthly Horoscope (${r.te} మాస ఫలాలు), ${M[today.m - 1].slice(0, 3)} ${today.y}`,
  tomorrow: `${r.skt} Rasi Phalalu Tomorrow (${r.te} రేపటి రాశి ఫలాలు), ${start.d} ${M[start.m - 1].slice(0, 3)} ${start.y}`,
};
const TE_M = ['జనవరి', 'ఫిబ్రవరి', 'మార్చి', 'ఏప్రిల్', 'మే', 'జూన్', 'జూలై', 'ఆగస్టు', 'సెప్టెంబర్', 'అక్టోబర్', 'నవంబర్', 'డిసెంబర్'];
const TE_RATE = ['', 'ఓర్పు అవసరం', 'జాగ్రత్తగా ఉండాలి', 'మిశ్రమ ఫలితాలు', 'మంచి రోజు', 'అద్భుతమైన రోజు'];
const df = (span === 'daily' || span === 'tomorrow') ? dayFacts(start) : null;
const teLine = df ? `${start.d} ${TE_M[start.m - 1]} ${start.y}: చంద్రుడు ${df.moonSign.te} రాశిలో, ${NAKSHATRAS_TE[df.nak.index] ?? df.nak.name} నక్షత్రంలో ఉంటాడు. ${r.te} రాశి వారికి ${span === 'tomorrow' ? 'రేపు' : 'ఈ రోజు'}: ${TE_RATE[d.rating] ?? ''}.` : '';
const base = span === 'tomorrow' ? `/horoscope-tomorrow/${r.id}/` : `/rasi-phalalu/${r.id}/`;
const dailyBase = `/rasi-phalalu/${r.id}/`;
const crumbs = span === 'tomorrow' ? [{ name: 'Tomorrow\'s horoscope', href: '/horoscope-tomorrow/' }, { name: r.skt, href: base }] : [{ name: 'Rasi Phalalu', href: '/rasi-phalalu/' }, { name: r.skt, href: base }, ...(span === 'daily' ? [] : [{ name: label, href: `${base}${span}/` }])];
---
<Base rail="astrology" title={titles[span]} description={`${r.skt} (${r.te}) ${label.toLowerCase()} horoscope (rasi phalalu) for career, money, relationships and health, worked out from planetary transits.`} active="astrology" breadcrumbs={crumbs} image={`/covers/r-${r.id}.png`}>
  <div class="page wide c-astrology">
    <div class="kicker"><a href="/rasi-phalalu/">Rasi Phalalu</a></div>
    <h1 style="display:flex;align-items:center;gap:14px;flex-wrap:wrap"><Glyph id={r.id} size={44} /> <span>{r.skt} Rasi <span class="te" style="font-weight:600">{r.te}</span></span> <span class="sub" style="font-family:var(--sans);font-weight:500;font-size:18px;letter-spacing:0">{r.en}</span></h1>
    <Hero name={`rashi-${r.id}`} alt={`${r.skt} (${r.en}) rashi illustration with its zodiac symbol`} ratio="16/6" />
    <div class="chips" style="margin:0 0 10px">{RASHIS.map((x) => <a href={span === 'tomorrow' ? `/horoscope-tomorrow/${x.id}/` : `/rasi-phalalu/${x.id}/${span === 'daily' ? '' : span + '/'}`} class={x.id === r.id ? 'on' : ''}>{x.skt}</a>)}</div>
    <div class="chips" style="margin:0 0 26px">
      <a href={dailyBase} class={span === 'daily' ? 'on' : ''}>Today</a><a href={`/horoscope-tomorrow/${r.id}/`} class={span === 'tomorrow' ? 'on' : ''}>Tomorrow</a><a href={`${dailyBase}weekly/`} class={span === 'weekly' ? 'on' : ''}>Weekly</a><a href={`${dailyBase}monthly/`} class={span === 'monthly' ? 'on' : ''}>Monthly</a>
    </div>
    <section class="reading">
      <div class="sect"><h2>{label}: {range}</h2></div>
      {teLine && <p class="te" style="margin:0 0 8px;font-size:17px;line-height:1.6">{teLine}</p>}
      <div class="rating-big"><span class="stars" aria-label={`${d.rating} of 5`}>{star(d.rating)}</span><small>{d.band}</small></div>
      <p class="dek" style="margin:6px 0 4px">{d.summary}</p>
      {d.daily && <p style="margin:8px 0 4px"><b>Focus of the day.</b> {d.daily.moon} {d.daily.nak} {d.daily.weekday}</p>}
      <div class="rgrid">
        {d.domains.map((x) => <div class="rcard"><b>{x.label}<em>{star(bandStars[x.band])}</em></b><p>{x.text}</p></div>)}
      </div>
      <div class="lucky"><span>Lucky colour: <b>{d.lucky.color}</b></span><span>Lucky number: <b>{d.lucky.number}</b></span></div>
      <p class="sub">Based on: {d.factors.join('; ')}.</p>
    </section>
    {span === 'daily' && <p class="dek" style="margin:22px 0 0"><a href={`/horoscope-tomorrow/${r.id}/`} style="text-decoration:underline"><b>See {r.skt} horoscope for tomorrow, {fd(addDays(today, 1))} &rarr;</b></a></p>}
    <p class="disc">For entertainment and reflection only. These readings come from the day's planetary positions using traditional Vedic transit rules, the same for everyone born under {r.skt} rashi. They are not predictions about your life and not a substitute for medical, legal or financial advice. Your rashi is the sign of your Moon at birth.</p>
  </div>
</Base>
