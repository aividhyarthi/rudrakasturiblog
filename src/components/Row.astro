---
import StoryImg from './StoryImg.astro';
import { categoryLabel, fmtDate, type Article } from '../lib/articles';
const { a } = Astro.props as { a: Article };
---
<a class={`row c-${a.data.category}`} href={`/${a.slug}/`}>
  <div class="imgwrap"><StoryImg slug={a.slug} alt={a.data.imageAlt ?? a.data.title} /></div>
  <div><span class="kicker">{categoryLabel(a.data.category)}</span><h3>{a.data.title}</h3><div class="meta">{fmtDate(a.data.date)}{a.data.draft ? ' · DRAFT' : ''}</div></div>
</a>
