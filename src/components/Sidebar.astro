---
import { allArticles } from '../lib/articles';
import { REGIONS, stateHref } from '../config';
const { exclude } = Astro.props as { exclude?: string };
const items = (await allArticles()).filter((a) => a.slug !== exclude).slice(0, 6);
const states = ['ap', 'ts', 'ka', 'tn', 'kl'] as const;
---
<aside>
  <div class="box"><h4>Trending</h4>{items.map((a, i) => <div class="rank"><span>{i + 1}</span><a href={`/${a.slug}/`}>{a.data.title}</a></div>)}</div>
  <div class="box"><h4>Today</h4><div style="display:grid;gap:6px;font-size:15px"><a href="/panchangam/hyderabad/" style="text-decoration:underline">Today's Panchangam</a><a href="/rasi-phalalu/" style="text-decoration:underline">Today's Rasi Phalalu</a><a href="/rahu-kalam-today/" style="text-decoration:underline">Rahu Kalam today</a><a href="/bhagavad-gita/" style="text-decoration:underline">Bhagavad Gita</a><a href="/temples/" style="text-decoration:underline">Temple guides</a></div></div>
  <div class="box"><h4>Browse by state</h4><div class="chips">{states.map((s) => <a href={stateHref(s)}>{REGIONS[s]}</a>)}</div></div>
</aside>
