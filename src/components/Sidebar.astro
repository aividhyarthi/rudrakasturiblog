---
import { allArticles, sectionCounts } from '../lib/articles';
import { REGIONS, stateHref } from '../config';
const { exclude } = Astro.props as { exclude?: string };
const items = (await allArticles()).filter((a) => a.slug !== exclude).slice(0, 6);
const counts = await sectionCounts();
const states = (['ap', 'ts', 'ka', 'tn', 'kl'] as const).filter((s) => counts.region[s]);
---
<aside>
  {items.length > 0 && <div class="box"><h4>Latest</h4>{items.map((a, i) => <div class="rank"><span>{i + 1}</span><a href={`/${a.slug}/`}>{a.data.title}</a></div>)}</div>}
  <div class="box"><h4>Southwala Devotional</h4><div class="links"><a href="/panchangam/hyderabad/">Today's Panchangam</a><a href="/rahu-kalam-today/">Rahu Kalam today</a><a href="/temples/">Temples</a><a href="/bhagavad-gita/">Bhagavad Gita</a></div></div>
  <div class="box"><h4>Southwala Astrology</h4><div class="links"><a href="/rasi-phalalu/">Today's Rasi Phalalu</a><a href="/rasi-phalalu/mesha/weekly/">Weekly horoscope</a><a href="/rasi-phalalu/mesha/monthly/">Monthly horoscope</a></div></div>
  {states.length > 0 && <div class="box"><h4>Browse by state</h4><div class="chips">{states.map((s) => <a href={stateHref(s)}>{REGIONS[s]}</a>)}</div></div>}
</aside>
