---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import { GUIDE } from '../data/guide-content';
import { fmt } from '../lib/fmt';
import { allArticles } from '../lib/articles';
import { permaPages } from '../lib/perma';
import { fmtTime, todayIST, ymdKey, WEEKDAYS, istParts } from '../lib/panchang';
import { MONTHS, EN_MONTH_NAMES } from '../lib/lunar';
import { allTithis, ROUTE, type Obs, type TithiKind } from '../lib/tithi';
import { COPY } from '../data/tithi-text';
const { kind } = Astro.props as { kind: TithiKind };
const c = COPY[kind], R = ROUTE[kind];
const all = allTithis(kind);
const shown = new Set(permaPages(kind).flatMap((p) => p.group.map((g) => g.key)));
const guide = GUIDE[kind];
const published = new Set((await allArticles()).map((a) => a.slug));
const monthChips = ['january','february','march','april','may','june','july','august','september','october','november','december'];
const today = todayIST(), tk = ymdKey(today);
const upcoming = all.filter((x) => x.key >= tk);
const next = upcoming[0];
const thisYear = all.filter((x) => x.observed.y === today.y);
const dt = (d: Date) => { const x = istParts(d); return `${WEEKDAYS[x.getUTCDay()].slice(0, 3)}, ${x.getUTCDate()} ${EN_MONTH_NAMES[x.getUTCMonth()].slice(0, 3)}, ${fmtTime(d)}`; };
const pretty = (x: Obs) => `${WEEKDAYS[x.weekday]}, ${x.observed.d} ${EN_MONTH_NAMES[x.observed.m - 1]} ${x.observed.y}`;
const extraHead = kind === 'sankashti' ? 'Moonrise (Hyderabad)' : kind === 'ekadashi' ? 'Parana (next day)' : 'Puja window (Hyderabad)';
const extra = (x: Obs) => kind === 'sankashti' ? (x.moonrise ? fmtTime(x.moonrise) : '') : kind === 'ekadashi' ? (x.parana ? `${fmtTime(x.parana.from)} to ${fmtTime(x.parana.to)}` : 'After sunrise') : (x.puja ? `${fmtTime(x.puja.from)} to ${fmtTime(x.puja.to)}` : '');
const faq: [string, string][] = [
  [`When is the next ${c.title}?`, next ? `The next ${c.title} is on ${pretty(next)}${kind === 'ekadashi' ? ` (${next.name})` : ''}. The tithi begins ${dt(next.start)} and ends ${dt(next.end)} (IST).` : ''],
  ...c.faq,
  ...((GUIDE[kind]?.faqs ?? []).filter(([q]) => !c.faq.some(([x]) => x === q))),
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
const basis = kind === 'ekadashi' ? 'present at sunrise' : kind === 'sankashti' ? 'present at moonrise' : 'present at sunset';
---
<Base rail="religion" title={`${c.title} ${today.y} Dates: Next ${next ? next.observed.d + ' ' + EN_MONTH_NAMES[next.observed.m - 1].slice(0, 3) : ''}, All Months & Timings`} description={`${c.title} dates for ${today.y} with exact tithi start and end times (IST) and ${extraHead.toLowerCase()}. Next ${c.title}: ${next ? pretty(next) : ''}.`} active="religion" breadcrumbs={[{ name: 'Devotional', href: '/religion/' }, { name: c.title, href: `/${R}/` }]} image="/covers/panchangam.png">
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <div class="page wide c-religion">
    <div class="kicker"><a href="/religion/">Devotional</a></div>
    <h1>{c.title} <span class="te">{c.te}</span> dates {today.y}</h1>
    <Hero name="moon-nakshatra" alt="The Moon among the stars of the nakshatras" ratio="16/5" />
    {next && (
      <a class="rcard" href={`/${R}/${next.slug}/`} style="display:block;margin:0 0 26px;text-decoration:none;color:inherit">
        <small style="text-transform:uppercase;letter-spacing:.06em;color:#6b6b6b">Next {c.title}</small>
        <b style="display:block;font-size:26px;margin:4px 0">{pretty(next)}</b>
        <span>{next.occasion}. Tithi begins {dt(next.start)} and ends {dt(next.end)} (IST).</span>
      </a>
    )}
    <p>{c.what}</p>
    <div class="sect"><h2>Upcoming {c.title} dates</h2></div>
    <div class="tw"><table class="data">
      <thead><tr><th>Date</th><th>Tithi begins</th><th>Tithi ends</th><th>{extraHead}</th><th>Occasion</th></tr></thead>
      <tbody>{upcoming.slice(0, 14).map((x) => <tr><td>{shown.has(x.key) ? <a href={`/${R}/${x.slug}/`} style="text-decoration:underline"><b>{pretty(x)}</b></a> : <b>{pretty(x)}</b>}</td><td>{dt(x.start)}</td><td>{dt(x.end)}</td><td>{extra(x)}</td><td>{kind === 'ekadashi' ? <b>{x.name}</b> : x.occasion}{kind === 'ekadashi' && <><br />{x.occasion}</>}</td></tr>)}</tbody>
    </table></div>
    <p class="sub">Times are Indian Standard Time. Tithi start and end times are the same across India. The date is the day on which the tithi is {basis}. Tap a date for the full guide.</p>
    {thisYear.length > 0 && <>
      <div class="sect" style="margin-top:26px"><h2>All {c.title} dates in {today.y}</h2></div>
      <div class="chips">{thisYear.map((x) => shown.has(x.key) ? <a href={`/${R}/${x.slug}/`}>{EN_MONTH_NAMES[x.observed.m - 1].slice(0, 3)} {x.observed.d}</a> : <span class="chip-off">{EN_MONTH_NAMES[x.observed.m - 1].slice(0, 3)} {x.observed.d}</span>)}</div>
    </>}
    {guide ? (
      <>
        <div class="sect" style="margin-top:26px"><h2>{kind === 'ekadashi' ? 'Every Ekadashi by name' : `${c.title} by month`}</h2></div>
        <div class="chips">{kind === 'ekadashi' ? permaPages('ekadashi').sort((a, b) => (a.primary.key < tk ? 1 : 0) - (b.primary.key < tk ? 1 : 0) || a.primary.key.localeCompare(b.primary.key)).map((pg) => <a href={`/${R}/${pg.slug}/`}>{(pg.primary as any).name.replace(' Ekadashi', '')}</a>) : monthChips.map((m) => <a href={`/${R}/${m}/`}>{m[0].toUpperCase() + m.slice(1)}</a>)}</div>
        {guide.sections.map((b) => (
          <>
            <div class="sect" style="margin-top:26px"><h2>{b.h}</h2></div>
            {b.p?.map((x) => <p set:html={fmt(x, published)} />)}
            {b.ul && <ul>{b.ul.map((x) => <li set:html={fmt(x, published)} />)}</ul>}
            {b.ol && <ol>{b.ol.map((x) => <li set:html={fmt(x, published)} />)}</ol>}
          </>
        ))}
      </>
    ) : (
      <>
        <div class="sect" style="margin-top:26px"><h2>What people traditionally do</h2></div>
        <ul>{c.do.map((x) => <li>{x}</li>)}</ul>
        <div class="sect"><h2>What many avoid</h2></div>
        <ul>{c.avoid.map((x) => <li>{x}</li>)}</ul>
      </>
    )}
    <div class="sect"><h2>Common questions</h2></div>
    {faq.map(([q, a]) => <><h3 style="margin-bottom:2px">{q}</h3><p style="margin-top:0">{a}</p></>)}
    {guide && guide.reads.filter((r) => published.has(r.href.replace(/\//g, '')) || r.href === '/somavati-amavasya/').length > 0 && <><div class="sect"><h2>Read more</h2></div><ul>{guide.reads.filter((r) => published.has(r.href.replace(/\//g, '')) || r.href === '/somavati-amavasya/').map((r) => <li><a href={r.href} style="text-decoration:underline">{r.label}</a></li>)}</ul></>}
    <div class="chips" style="margin-top:16px">
      {(['ekadashi', 'sankashti', 'pradosham'] as TithiKind[]).filter((k) => k !== kind).map((k) => <a href={`/${ROUTE[k]}/`}>{COPY[k].title} dates</a>)}
      <a href="/amavasya/">Amavasya dates</a><a href="/pournami/">Pournami dates</a><a href="/panchangam/">Today's panchangam</a>
    </div>
    <p class="disc">Calculated from the astronomical positions of the Sun and Moon (Lahiri ayanamsa). Traditions vary by region and family. For vratams, confirm the day with your family priest or temple.</p>
  </div>
</Base>
