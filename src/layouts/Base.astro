---
import '@fontsource-variable/fraunces/wght.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/source-serif-4/wght.css';
import '@fontsource/noto-serif-telugu/telugu-400.css';
import '@fontsource/noto-serif-telugu/telugu-600.css';
import '@fontsource/noto-serif-telugu/telugu-700.css';
import '@fontsource/noto-sans-telugu/telugu-400.css';
import '@fontsource/noto-sans-telugu/telugu-600.css';
import '../styles/global.css';
import { SITE, SECTIONS, SUBNAV, ADSENSE_CLIENT, GA_ID } from '../config';
import { sectionCounts } from '../lib/articles';
import { panchangFor, fmtTime, todayIST } from '../lib/panchang';
import SideRail from '../components/SideRail.astro';
interface Props { railNoToday?: boolean; rail?: string; railExclude?: string; todayBar?: boolean; breadcrumbs?: { name: string; href: string }[]; home?: boolean; title?: string; description?: string; image?: string; type?: 'website' | 'article'; jsonLd?: object; active?: string; noindex?: boolean; published?: Date; modified?: Date }
const { railNoToday, rail, railExclude, todayBar, breadcrumbs, home, title, description = SITE.description, image, type = 'website', jsonLd, active, noindex, published, modified } = Astro.props;
const fullTitle = title ? (title.length + SITE.name.length + 3 <= 62 ? `${title} | ${SITE.name}` : title) : `${SITE.name}: ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const counts = await sectionCounts();
const nav = SECTIONS.filter((s) => s.always || counts.cat[s.id]);
const section = SECTIONS.find((s) => s.id === active);
const subnav = (active && SUBNAV[active]) || [];
const _y = todayIST(); const _p = panchangFor(_y, 'hyderabad'); const _ref = new Date(Date.UTC(_y.y, _y.m - 1, _y.d));
const snap = { tithi: `${_p.tithi[0].paksha} ${_p.tithi[0].name}`, nak: _p.nakshatra[0].name, rahu: `${fmtTime(_p.rahu.start, _ref)} to ${fmtTime(_p.rahu.end, _ref)}` };
const crumbLd = breadcrumbs && breadcrumbs.length ? { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ name: 'Home', href: '/' }, ...breadcrumbs].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, SITE.url).href })) } : null;
const orgLd = home ? [
  { '@context': 'https://schema.org', '@type': 'NewsMediaOrganization', name: SITE.name, url: SITE.url, logo: { '@type': 'ImageObject', url: `${SITE.url}/logo.png`, width: 512, height: 512 }, email: SITE.email, publishingPrinciples: `${SITE.url}/editorial-policy/` },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url },
] : null;
const ogImage = image ? new URL(image, SITE.url).href : new URL('/covers/home.png', SITE.url).href;
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />
  <meta name="theme-color" content="#ffffff" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title ?? SITE.name} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="675" />
  <meta name="twitter:card" content="summary_large_image" />
  {published && <meta property="article:published_time" content={published.toISOString()} />}
  {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  {crumbLd && <script type="application/ld+json" set:html={JSON.stringify(crumbLd)} />}
  {orgLd && orgLd.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  {ADSENSE_CLIENT && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous"></script>}
  {GA_ID && <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>}
  {GA_ID && <script is:inline define:vars={{ GA_ID }}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',GA_ID);</script>}
</head>
<body data-sec={active}>
  <div class="topbar"><div class="wrap">
    <span id="today">{SITE.tagline}</span>
    <span>Hyderabad today: {snap.tithi} &middot; {snap.nak} nakshatra &middot; Rahu Kalam {snap.rahu} &middot; <a href="/panchangam/hyderabad/">Panchangam</a></span>
  </div></div>
  <header class="mast">
    <a class="logo" href="/" aria-label="Southwala home">Southwala<i>.</i></a>
    <p class="tagline">Andhra &middot; Telangana &middot; Karnataka &middot; Tamil Nadu &middot; Kerala</p>
  </header>
  <nav class="nav" aria-label="Sections"><div class="wrap">
    <a href="/" class={!active ? 'on' : ''}>Home</a>
    {nav.map((c) => <a href={c.href} class={active === c.id ? 'on' : ''} style={`--navc:${c.accent}`}>{c.label}</a>)}
  </div></nav>
  {section && (
    <div class="brandbar"><div class="wrap">
      <a class="brand" href={section.href}>{section.brand}</a>
      {subnav.length > 0 ? <div class="subnav">{subnav.map((s) => <a href={s.href}>{s.label}</a>)}</div> : <span class="meta">{section.tag}</span>}
    </div></div>
  )}
  <script is:inline>try{document.getElementById('today').textContent=new Date().toLocaleDateString('en-IN',{weekday:'long',day:'numeric',month:'long',year:'numeric',timeZone:'Asia/Kolkata'})}catch(e){}</script>
  <main>{rail ? <div class="wrap layout"><div class="main-col"><slot /></div><SideRail section={rail} exclude={railExclude} noToday={railNoToday} /></div> : <slot />}</main>
  <footer class="foot"><div class="wrap">
    <div>
      <a class="logo" href="/" style="display:inline-block;padding:0">Southwala<i>.</i></a>
      <p style="margin-top:14px">{SITE.description}</p>
    </div>
    <div>
      <h4>Sections</h4>
      {nav.map((c) => <a href={c.href}>{c.label}</a>)}
      <a href="/temples/">Temples</a><a href="/bhagavad-gita/">Bhagavad Gita</a>
    </div>
    <div>
      <h4>Trust</h4>
      <a href="/about/">About</a><a href="/team/">Our desks</a><a href="/editorial-policy/">Editorial policy</a><a href="/right-of-reply/">Right of reply</a><a href="/contact/">Contact</a><a href="/privacy-policy/">Privacy</a><a href="/rss.xml">RSS</a>
    </div>
    <div class="legal">&copy; {new Date().getFullYear()} {SITE.name}. Opinion and analysis are labelled. Bylines are AI-assisted desk voices. Corrections: {SITE.email}</div>
  </div></footer>
</body>
</html>
