---
import '@fontsource-variable/fraunces/wght.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/source-serif-4/wght.css';
import '@fontsource/noto-serif-telugu/telugu-400.css';
import '@fontsource/noto-serif-telugu/telugu-600.css';
import '@fontsource/noto-serif-telugu/telugu-700.css';
import '@fontsource/noto-sans-telugu/telugu-400.css';
import '@fontsource/noto-sans-telugu/telugu-600.css';
import '../styles/global.css';
import { SITE, SECTIONS, SUBNAV, ADSENSE_CLIENT, GA_ID, GSC_VERIFICATION, NEWS_ENABLED, CATEGORIES, NEWS_CATS, SERIES, CAT_SLUG, catHref, seriesHref } from '../config';
import { sectionCounts, seriesCounts } from '../lib/articles';
import { istIso } from '../lib/ist';
import { panchangFor, fmtTime, todayIST } from '../lib/panchang';
import SideRail from '../components/SideRail.astro';
interface Props { railNoToday?: boolean; rail?: string; railExclude?: string; todayBar?: boolean; breadcrumbs?: { name: string; href: string }[]; home?: boolean; title?: string; description?: string; image?: string; type?: 'website' | 'article'; jsonLd?: object; active?: string; noindex?: boolean; published?: Date; modified?: Date; imageAlt?: string; imageW?: number; imageH?: number; section?: string; tags?: string[]; author?: string }
const { railNoToday, rail, railExclude, todayBar, breadcrumbs, home, title, description = SITE.description, image, type = 'website', jsonLd, active, noindex, published, modified, imageAlt, imageW = 1200, imageH = 675, section: artSection, tags = [], author } = Astro.props;
const fullTitle = title ? (title.length + SITE.name.length + 3 <= 62 ? `${title} | ${SITE.name}` : title) : `${SITE.name}: ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const counts = await sectionCounts();
const nav = SECTIONS.filter((s) => s.always || (NEWS_ENABLED && counts.cat[s.id]));
const section = SECTIONS.find((s) => s.id === active);
const sc = await seriesCounts();
// Hide links to topic and series pages that do not exist yet (a page is built once it has a published article).
const hasPage = (href: string) => {
  const cat = CATEGORIES.find((c) => catHref(c.id) === href);
  if (cat) return !!counts.cat[cat.id];
  if (href === '/series/') return Object.keys(sc).length > 0;
  if (href.startsWith('/series/')) return !!sc[href.split('/')[2]];
  return true;
};
const subnav = ((active && SUBNAV[active]) || []).filter((s) => hasPage(s.href));
const exploreCats = CATEGORIES.filter((c) => !NEWS_CATS.includes(c.id) && counts.cat[c.id]);
const exploreSeries = SERIES.filter((s) => sc[s.id]);
const _y = todayIST(); const _p = panchangFor(_y, 'hyderabad'); const _ref = new Date(Date.UTC(_y.y, _y.m - 1, _y.d));
const snap = { tithi: `${_p.tithi[0].paksha} ${_p.tithi[0].name}`, nak: _p.nakshatra[0].name, rahu: `${fmtTime(_p.rahu.start, _ref)} to ${fmtTime(_p.rahu.end, _ref)}` };
const crumbLd = breadcrumbs && breadcrumbs.length ? { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ name: 'Home', href: '/' }, ...breadcrumbs].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, SITE.url).href })) } : null;
const orgLd = home ? [
  { '@context': 'https://schema.org', '@type': 'NewsMediaOrganization', name: SITE.name, url: SITE.url, logo: { '@type': 'ImageObject', url: `${SITE.url}/logo.png`, width: 512, height: 512 }, email: SITE.email, publishingPrinciples: `${SITE.url}/editorial-policy/` },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url },
] : null;
const ogImage = image ? new URL(image, SITE.url).href : new URL('/covers/home.png', SITE.url).href;
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="google-site-verification" content={GSC_VERIFICATION} />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />
  <meta name="theme-color" content="#ffffff" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title ?? SITE.name} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content={String(imageW)} />
  <meta property="og:image:height" content={String(imageH)} />
  <meta property="og:image:type" content={ogImage.endsWith(".jpg") ? "image/jpeg" : "image/png"} />
  <meta property="og:image:alt" content={imageAlt ?? title ?? SITE.name} />
  <meta property="og:locale" content="en_IN" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title ?? SITE.name} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={imageAlt ?? title ?? SITE.name} />
  {author && <meta name="author" content={author} />}
  {type === 'article' && author && <meta property="article:author" content={author} />}
  {artSection && <meta property="article:section" content={artSection} />}
  {tags.map((t) => <meta property="article:tag" content={t} />)}
  {published && <meta property="article:published_time" content={istIso(published)} />}
  {modified && <meta property="article:modified_time" content={istIso(modified)} />}
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
  <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png?v=2" type="image/png" sizes="32x32" />
  <link rel="icon" href="/favicon-48.png?v=2" type="image/png" sizes="48x48" />
  <link rel="shortcut icon" href="/favicon.ico?v=2" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
  <link rel="manifest" href="/site.webmanifest" />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  {crumbLd && <script type="application/ld+json" set:html={JSON.stringify(crumbLd)} />}
  {orgLd && orgLd.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  {ADSENSE_CLIENT && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous"></script>}
  {GA_ID && <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>}
  {GA_ID && <script is:inline define:vars={{ GA_ID }}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',GA_ID);</script>}
</head>
<body data-sec={active}>
  <div class="topbar"><div class="wrap">
    <span id="today">{SITE.tagline}</span>
    <span><span data-local="name">Hyderabad</span> today: <span data-local="tithi">{snap.tithi}</span> &middot; <span data-local="nakshatra">{snap.nak}</span> nakshatra &middot; Rahu Kalam <span data-local="rahu">{snap.rahu}</span> &middot; <a href="/panchangam/">Panchangam</a></span>
  </div></div>
  <header class="mast">
    <a class="logo" href="/" aria-label="Southwala home">Southwala<i>.</i></a>
    <p class="tagline">{SITE.tagline}</p>
  </header>
  <nav class="nav" aria-label="Sections"><div class="wrap">
    <a href="/" class={!active ? 'on' : ''}>Home</a>
    {nav.map((c) => <a href={c.href} class={active === c.id ? 'on' : ''} style={`--navc:${c.accent}`}>{c.label}</a>)}
    <a href="/topics/" class={Astro.url.pathname.startsWith('/topics') || Astro.url.pathname.startsWith('/series') ? 'on' : ''} style="--navc:#444">Topics</a>
  </div></nav>
  {section && (
    <div class="brandbar"><div class="wrap">
      <a class="brand" href={section.href}>{section.brand}</a>
      {subnav.length > 0 ? <div class="subnav">{subnav.map((s) => <a href={s.href}>{s.label}</a>)}</div> : <span class="meta">{section.tag}</span>}
    </div></div>
  )}
  <script is:inline>try{document.getElementById('today').textContent=new Date().toLocaleDateString('en-IN',{weekday:'long',day:'numeric',month:'long',year:'numeric',timeZone:'Asia/Kolkata'})}catch(e){}</script>
  <main>{rail ? <div class="wrap layout"><div class="main-col"><slot /></div><SideRail section={rail} exclude={railExclude} noToday={railNoToday} /></div> : <slot />}</main>
  <footer class="foot"><div class="wrap">
    <div>
      <a class="logo" href="/" style="display:inline-block;padding:0">Southwala<i>.</i></a>
      <p style="margin-top:14px">{SITE.description}</p>
    </div>
    <div>
      <h4>Sections</h4>
      {nav.map((c) => <a href={c.href}>{c.label}</a>)}
      <a href="/panchangam/">Panchangam</a><a href="/amavasya/">Amavasya</a><a href="/pournami/">Pournami</a><a href="/ekadashi/">Ekadashi</a><a href="/sankashti-chaturthi/">Sankashti</a><a href="/pradosham/">Pradosham</a>
    </div>
    <div>
      <h4>Topics</h4>
      {exploreCats.map((c) => <a href={catHref(c.id)}>{c.label}</a>)}
      <a href="/topics/">All topics</a>
    </div>
    {exploreSeries.length > 0 && <div>
      <h4>Series</h4>
      {exploreSeries.map((s) => <a href={seriesHref(s.id)}>{s.label}</a>)}
    </div>}
    <div>
      <h4>Trust</h4>
      <a href="/about/">About</a><a href="/team/">Our contributors</a><a href="/editorial-policy/">Editorial policy</a><a href="/right-of-reply/">Right of reply</a><a href="/contact/">Contact</a><a href="/privacy-policy/">Privacy</a><a href="/rss.xml">RSS</a>
    </div>
    <div class="legal">&copy; {new Date().getFullYear()} {SITE.name}. Corrections and suggestions: {SITE.email}</div>
  </div></footer>
  <script>import '../scripts/local';</script>
</body>
</html>
