---
import { nowDate } from '../lib/now';
import '@fontsource-variable/fraunces/wght.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/source-serif-4/wght.css';
import '@fontsource/noto-serif-telugu/telugu-400.css';
import '@fontsource/noto-serif-telugu/telugu-600.css';
import '@fontsource/noto-serif-telugu/telugu-700.css';
import '@fontsource/noto-sans-telugu/telugu-400.css';
import '@fontsource/noto-sans-telugu/telugu-600.css';
import '../styles/global.css';
import { SITE, SECTIONS, SUBNAV, ADSENSE_CLIENT, GA_ID, GSC_VERIFICATION, NEWS_ENABLED, CATEGORIES, NEWS_CATS, SERIES, CAT_SLUG, catHref, seriesHref } from '../config';
import { sectionCounts, seriesCounts } from '../lib/articles';
import { istIso } from '../lib/ist';
import buildStamp from '../data/build-stamp.txt?raw';
import { panchangFor, fmtTime, todayIST } from '../lib/panchang';
import SideRail from '../components/SideRail.astro';
import { masaOn, masaStartingSoon } from '../lib/masa';
import { MASA_TEXT } from '../data/masa';
interface Props { railNoToday?: boolean; rail?: string; railExclude?: string; todayBar?: boolean; breadcrumbs?: { name: string; href: string }[]; home?: boolean; title?: string; description?: string; image?: string; type?: 'website' | 'article'; jsonLd?: object; active?: string; noindex?: boolean; published?: Date; modified?: Date; imageAlt?: string; imageW?: number; imageH?: number; section?: string; tags?: string[]; author?: string; evergreen?: boolean; schemaBody?: string; webPageType?: string }
const { railNoToday, rail, railExclude, todayBar, breadcrumbs, home, title, description = SITE.description, image, type = 'website', jsonLd, active, noindex, published, modified, imageAlt, imageW = 1200, imageH = 675, section: artSection, tags = [], author, evergreen, schemaBody, webPageType } = Astro.props;
const fullTitle = title ? (title.length + SITE.name.length + 3 <= 62 ? `${title} | ${SITE.name}` : title) : `${SITE.name}: ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const counts = await sectionCounts();
const nav = SECTIONS.filter((s) => s.always || (NEWS_ENABLED && counts.cat[s.id]));
const section = SECTIONS.find((s) => s.id === active);
const onFestivals = Astro.url.pathname.startsWith('/festivals');
const sc = await seriesCounts();
// Hide links to topic and series pages that do not exist yet (a page is built once it has a published article).
const hasPage = (href: string) => {
  const cat = CATEGORIES.find((c) => catHref(c.id) === href);
  if (cat) return !!counts.cat[cat.id];
  if (href === '/series/') return Object.keys(sc).length > 0;
  if (href.startsWith('/series/')) return !!sc[href.split('/')[2]];
  return true;
};
const RASHI_IDS = ['mesha', 'vrishabha', 'mithuna', 'karkataka', 'simha', 'kanya', 'tula', 'vrischika', 'dhanu', 'makara', 'kumbha', 'meena'];
const onRashi = Astro.url.pathname.match(/^\/(?:rasi-phalalu|horoscope-tomorrow)\/([a-z]+)\//)?.[1];
const rid = onRashi && RASHI_IDS.includes(onRashi) ? onRashi : null;
// On a rashi's page the horoscope menu stays on that rashi: Leo's Tomorrow goes to Leo's tomorrow, not to the general page.
const toRashi = (h: string) => !rid ? h : h === '/rasi-phalalu/' ? `/rasi-phalalu/${rid}/` : h === '/horoscope-tomorrow/' ? `/horoscope-tomorrow/${rid}/` : h === '/rasi-phalalu/mesha/weekly/' ? `/rasi-phalalu/${rid}/weekly/` : h === '/rasi-phalalu/mesha/monthly/' ? `/rasi-phalalu/${rid}/monthly/` : h;
const subnav = ((active && SUBNAV[active]) || []).filter((s) => hasPage(s.href)).map((s) => ({ ...s, href: toRashi(s.href) }));
const exploreCats = CATEGORIES.filter((c) => !NEWS_CATS.includes(c.id) && counts.cat[c.id]);
const exploreSeries = SERIES.filter((s) => sc[s.id]);
const _y = todayIST(); const _p = panchangFor(_y, 'hyderabad'); const _ref = new Date(Date.UTC(_y.y, _y.m - 1, _y.d));
const snap = { tithi: `${_p.tithi[0].paksha} ${_p.tithi[0].name}`, nak: _p.nakshatra[0].name, rahu: `${fmtTime(_p.rahu.start, _ref)} to ${fmtTime(_p.rahu.end, _ref)}` };
const _today = todayIST(), _here = masaOn(_today), _soon = masaStartingSoon(_today, 3);
const _hasT = (x: { name: string; adhika: boolean }) => !x.adhika && !!MASA_TEXT[x.name];
const _tom = _soon && _soon.inDays <= 1 && _hasT(_soon.masa) ? _soon : null; // last day of a month: say the next one begins tomorrow
const _mt = _tom ? { t: MASA_TEXT[_tom.masa.name], label: `${MASA_TEXT[_tom.masa.name].show} begins tomorrow` } : _hasT(_here) ? { t: MASA_TEXT[_here.name], label: `${MASA_TEXT[_here.name].show}, day ${_here.dayNo}` } : _soon && _hasT(_soon.masa) ? { t: MASA_TEXT[_soon.masa.name], label: `${MASA_TEXT[_soon.masa.name].show} begins ${_soon.inDays === 1 ? 'tomorrow' : `in ${_soon.inDays} days`}` } : null;
const masaChip = _mt?.label, masaHref = _mt?.t.links[0].href;
const crumbLd = breadcrumbs && breadcrumbs.length ? { '@context': 'https://schema.org', '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumb`, itemListElement: [{ name: 'Home', href: '/' }, ...breadcrumbs].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, SITE.url).href })) } : null;
// ---- structured data: one graph with the organisation, the site, this page and (for evergreen pages) an Article ----
const ORG_ID = `${SITE.url}/#organization`, SITE_ID = `${SITE.url}/#website`, PAGE_ID = `${canonical}#webpage`;
const sameAs = [SITE.twitter && `https://x.com/${SITE.twitter}`, SITE.instagram && `https://www.instagram.com/${SITE.instagram}`].filter(Boolean);
const orgNode = { '@type': ['Organization', 'NewsMediaOrganization'], '@id': ORG_ID, name: SITE.name, alternateName: 'Southwala.com', url: SITE.url, description: SITE.description, slogan: SITE.tagline, logo: { '@type': 'ImageObject', '@id': `${SITE.url}/#logo`, url: `${SITE.url}/logo.png`, contentUrl: `${SITE.url}/logo.png`, width: 512, height: 512, caption: SITE.name }, image: { '@id': `${SITE.url}/#logo` }, email: SITE.email, foundingDate: '2026-10-20', areaServed: { '@type': 'Country', name: 'India' }, knowsAbout: ['Panchangam', 'Hindu festivals', 'Vedic astrology', 'Rasi phalalu', 'Temples of South India', 'Bhagavad Gita', 'Amavasya and Pournami', 'Ekadashi'], knowsLanguage: ['en-IN', 'te', 'ta', 'kn', 'ml'], publishingPrinciples: `${SITE.url}/editorial-policy/`, ethicsPolicy: `${SITE.url}/editorial-policy/`, contactPoint: { '@type': 'ContactPoint', contactType: 'editorial', email: SITE.email, availableLanguage: ['English', 'Telugu', 'Tamil', 'Kannada', 'Malayalam'] }, ...(sameAs.length ? { sameAs } : {}) };
const siteNode = { '@type': 'WebSite', '@id': SITE_ID, name: SITE.name, alternateName: 'Southwala.com', url: SITE.url, description: SITE.description, inLanguage: 'en-IN', publisher: { '@id': ORG_ID } };
const jsonTypes = [jsonLd].flat().filter(Boolean).map((j: any) => j['@type']);
const hasArticle = jsonTypes.some((t: any) => /Article/.test(String(t)));
const EVERGREEN = /^\/(festivals|amavasya|pournami|sankashti-chaturthi|pradosham|ekadashi|somavati-amavasya|sade-sati|masam|rasi-phalalu|horoscope-tomorrow|panchangam-tomorrow|mantras|gods|temples|series|topics|calendar|rahu-kalam-today|religion|panchangam)(\/|$)/;
const isDatedPanchangamPage = /^\/panchangam\/[a-z]+\/\d{4}-\d{2}-\d{2}\//.test(Astro.url.pathname);
const isEvergreen = evergreen ?? (!home && type !== 'article' && !hasArticle && !isDatedPanchangamPage && EVERGREEN.test(Astro.url.pathname));
const nowIso = istIso(nowDate());
const LAUNCH = '2026-10-20T00:00:00+05:30';
const pageImage = { '@type': 'ImageObject', '@id': `${canonical}#primaryimage`, url: new URL(image ?? '/covers/home.png', SITE.url).href, contentUrl: new URL(image ?? '/covers/home.png', SITE.url).href, width: imageW, height: imageH, caption: imageAlt ?? title ?? SITE.name };
const sectionName = artSection ?? (breadcrumbs && breadcrumbs[0]?.name) ?? SITE.name;
const bodyText = (schemaBody ?? description ?? '').replace(/\s+/g, ' ').trim();
const navItems = [{ name: 'Home', href: '/' }, ...nav.map((c: any) => ({ name: c.label, href: c.href })), { name: 'Festivals', href: '/festivals/' }, { name: 'Topics', href: '/topics/' }];
const pageNode: any = { '@type': home ? ['WebPage', 'CollectionPage'] : (webPageType ?? 'WebPage'), '@id': PAGE_ID, url: canonical, name: fullTitle, description, inLanguage: 'en-IN', isPartOf: { '@id': SITE_ID }, publisher: { '@id': ORG_ID }, primaryImageOfPage: { '@id': `${canonical}#primaryimage` }, image: { '@id': `${canonical}#primaryimage` }, thumbnailUrl: pageImage.url, dateModified: nowIso, ...(published ? { datePublished: istIso(published) } : isEvergreen ? { datePublished: LAUNCH } : {}), ...(breadcrumbs && breadcrumbs.length ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } } : {}), potentialAction: { '@type': 'ReadAction', target: [canonical] }, speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', '.dek', '.answer', '.tldr'] } };
const graph: any[] = [orgNode, siteNode, pageImage, pageNode];
if (home) graph.push({ '@type': 'ItemList', '@id': `${SITE.url}/#navigation`, name: 'Southwala main navigation', itemListElement: navItems.map((n: any, i: number) => ({ '@type': 'SiteNavigationElement', position: i + 1, name: n.name, url: new URL(n.href, SITE.url).href })) });
if (isEvergreen) graph.push({ '@type': 'Article', '@id': `${canonical}#article`, headline: (title ?? SITE.name).slice(0, 110), alternativeHeadline: fullTitle.slice(0, 110), description, image: [pageImage.url], thumbnailUrl: pageImage.url, inLanguage: 'en-IN', isAccessibleForFree: true, datePublished: LAUNCH, dateModified: nowIso, author: { '@type': 'Organization', name: author ?? 'Southwala Desk', url: `${SITE.url}/team/` }, publisher: { '@id': ORG_ID }, mainEntityOfPage: { '@id': PAGE_ID }, isPartOf: { '@id': PAGE_ID }, articleSection: sectionName, keywords: (tags.length ? tags : [title ?? SITE.name, sectionName, 'Southwala']).join(', '), wordCount: bodyText.split(' ').filter(Boolean).length, articleBody: bodyText.slice(0, 20000), copyrightHolder: { '@id': ORG_ID }, copyrightYear: 2026 });
const graphLd = { '@context': 'https://schema.org', '@graph': graph };
const ogImage = image ? new URL(image, SITE.url).href : new URL('/covers/home.png', SITE.url).href;
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="google-site-verification" content={GSC_VERIFICATION} />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="build" content={buildStamp.trim()} />
  <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />
  <meta name="theme-color" content="#ffffff" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title ?? SITE.name} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content={String(imageW)} />
  <meta property="og:image:height" content={String(imageH)} />
  <meta property="og:image:type" content={ogImage.endsWith(".jpg") ? "image/jpeg" : "image/png"} />
  <meta property="og:image:alt" content={imageAlt ?? title ?? SITE.name} />
  <meta property="og:locale" content="en_IN" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title ?? SITE.name} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={imageAlt ?? title ?? SITE.name} />
  {author && <meta name="author" content={author} />}
  {type === 'article' && author && <meta property="article:author" content={author} />}
  {artSection && <meta property="article:section" content={artSection} />}
  {tags.map((t) => <meta property="article:tag" content={t} />)}
  {published && <meta property="article:published_time" content={istIso(published)} />}
  {modified && <meta property="article:modified_time" content={istIso(modified)} />}
  {isEvergreen && <meta property="og:updated_time" content={nowIso} />}
  {isEvergreen && <meta property="article:modified_time" content={nowIso} />}
  {isEvergreen && <meta property="article:published_time" content={LAUNCH} />}
  {isEvergreen && <meta property="article:section" content={sectionName} />}
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  {crumbLd && <script type="application/ld+json" set:html={JSON.stringify(crumbLd)} />}
  <script type="application/ld+json" set:html={JSON.stringify(graphLd)} />
  {ADSENSE_CLIENT && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous"></script>}
  {GA_ID && <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>}
  {GA_ID && <script is:inline define:vars={{ GA_ID }}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',GA_ID);</script>}
</head>
<body data-sec={active}>
  <div class="topbar"><div class="wrap">
    <span id="today">{SITE.tagline}</span>
    <span>{masaChip && <a class="masa-chip" href={masaHref}>{masaChip}</a>}<span data-local="name">Hyderabad</span> today: <span data-local="tithi">{snap.tithi}</span> &middot; <span data-local="nakshatra">{snap.nak}</span> nakshatra &middot; Rahu Kalam <span data-local="rahu">{snap.rahu}</span> &middot; <a href="/panchangam/">Panchangam</a></span>
  </div></div>
  <header class="mast">
    <a class="logo" href="/" aria-label="Southwala home">Southwala<i>.</i></a>
    <p class="tagline">{SITE.tagline}</p>
  </header>
  <nav class="nav" aria-label="Sections"><div class="wrap">
    <a href="/" class={!active ? 'on' : ''}>Home</a>
    {nav.map((c) => <a href={c.href} class={active === c.id && !onFestivals ? 'on' : ''} style={`--navc:${c.accent}`}>{c.label}</a>)}
    <a href="/festivals/" class={onFestivals ? 'on' : ''} style="--navc:#b4530a">Festivals</a>
    <a href="/topics/" class={Astro.url.pathname.startsWith('/topics') || Astro.url.pathname.startsWith('/series') ? 'on' : ''} style="--navc:#444">Topics</a>
  </div></nav>
  {section && (
    <div class="brandbar"><div class="wrap">
      <a class="brand" href={section.href}>{section.brand}</a>
      {subnav.length > 0 ? <div class="subnav">{subnav.map((s) => <a href={s.href}>{s.label}</a>)}</div> : <span class="meta">{section.tag}</span>}
    </div></div>
  )}
  <script is:inline>try{document.getElementById('today').textContent=new Date().toLocaleDateString('en-IN',{weekday:'long',day:'numeric',month:'long',year:'numeric',timeZone:'Asia/Kolkata'})}catch(e){}</script>
  <main>{rail ? <div class="wrap layout"><div class="main-col"><slot /></div><SideRail section={rail} exclude={railExclude} noToday={railNoToday} /></div> : <slot />}</main>
  <footer class="foot"><div class="wrap">
    <div>
      <a class="logo" href="/" style="display:inline-block;padding:0">Southwala<i>.</i></a>
      <p style="margin-top:14px">{SITE.description}</p>
    </div>
    <div>
      <h4>Sections</h4>
      {nav.map((c) => <a href={c.href}>{c.label}</a>)}
      <a href="/panchangam/">Panchangam</a><a href="/amavasya/">Amavasya</a><a href="/pournami/">Pournami</a><a href="/ekadashi/">Ekadashi</a><a href="/sankashti-chaturthi/">Sankashti</a><a href="/pradosham/">Pradosham</a><a href="/calendar/">Calendar 2027 (PDF)</a>
    </div>
    <div>
      <h4>Topics</h4>
      {exploreCats.map((c) => <a href={catHref(c.id)}>{c.label}</a>)}
      <a href="/topics/">All topics</a>
    </div>
    {exploreSeries.length > 0 && <div>
      <h4>Series</h4>
      {exploreSeries.map((s) => <a href={seriesHref(s.id)}>{s.label}</a>)}
    </div>}
    <div>
      <h4>Trust</h4>
      <a href="/about/">About</a><a href="/team/">Our contributors</a><a href="/editorial-policy/">Editorial policy</a><a href="/right-of-reply/">Right of reply</a><a href="/contact/">Contact</a><a href="/privacy-policy/">Privacy</a><a href="/rss.xml">RSS</a>
    </div>
    <div class="legal">&copy; {new Date().getFullYear()} {SITE.name}. Corrections and suggestions: {SITE.email}</div>
  </div></footer>
  <script>import '../scripts/local';</script>
  <script>import '../scripts/popups';</script>
</body>
</html>
