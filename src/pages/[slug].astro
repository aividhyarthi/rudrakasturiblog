---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import StoryImg from '../components/StoryImg.astro';
import LatestList from '../components/LatestList.astro';
import { allArticles, categoryLabel, fmtDate, findAuthor, sectionCounts } from '../lib/articles';
import { SITE, REGIONS, REGION_SLUG, CAT_SLUG, SECTIONS, catHref, stateHref } from '../config';

// One route serves stories, plus section and state pages that exist only once they have stories.
export async function getStaticPaths() {
  const all = await allArticles();
  const paths: any[] = all.map((a) => ({ params: { slug: a.slug }, props: { type: 'article', a, related: all.filter((x) => x.slug !== a.slug && x.data.category === a.data.category).slice(0, 3) } }));
  const counts = await sectionCounts();
  for (const s of SECTIONS) {
    if (s.id === 'politics' || s.always) continue; // politics has its own hub page
    if (counts.cat[s.id]) paths.push({ params: { slug: CAT_SLUG[s.id] }, props: { type: 'category', id: s.id } });
  }
  for (const [code, slug] of Object.entries(REGION_SLUG)) if (counts.region[code]) paths.push({ params: { slug }, props: { type: 'state', code } });
  return paths;
}
const props = Astro.props as any;
const all = await allArticles();
const isArticle = props.type === 'article';

// ---- article ----
let a: any, d: any, Content: any, jsonLd: any, byUrl = '', who: any, share = '', mins = 1, initials = '', crumbs: any[] = [];
if (isArticle) {
  a = props.a; d = a.data;
  Content = (await a.render()).Content;
  const url = `${SITE.url}/${a.slug}/`;
  who = findAuthor(d.author);
  byUrl = who ? `/author/${who.slug}/` : '/team/';
  mins = Math.max(1, Math.round(((a.body ?? '').split(/\s+/).length) / 210));
  initials = d.author.split(' ').map((w: string) => w[0]).slice(0, 2).join('');
  share = encodeURIComponent(`${d.title} ${url}`);
  const img = d.image ?? `/covers/${a.slug}.png`;
  jsonLd = {
    '@context': 'https://schema.org', '@type': 'NewsArticle', headline: d.title, description: d.description,
    image: [new URL(img, SITE.url).href], datePublished: d.date.toISOString(), dateModified: (d.updated ?? d.date).toISOString(),
    author: { '@type': 'Person', name: d.author, url: `${SITE.url}${byUrl}`, description: 'AI-assisted Southwala desk byline' },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url, logo: { '@type': 'ImageObject', url: `${SITE.url}/logo.png` } },
    mainEntityOfPage: url, articleSection: categoryLabel(d.category),
  };
  crumbs = [{ name: categoryLabel(d.category), href: catHref(d.category) }, { name: d.title, href: `/${a.slug}/` }];
}
// ---- section / state list ----
const isCat = props.type === 'category';
const sec = isCat ? SECTIONS.find((s) => s.id === props.id)! : null;
const listTitle = isCat ? sec!.brand : `${REGIONS[props.code as keyof typeof REGIONS]} news`;
const items = isArticle ? [] : all.filter((x) => (isCat ? x.data.category === props.id : x.data.region === props.code));
const blurb = isCat ? sec!.tag : `Politics, cinema and OTT from ${REGIONS[props.code as keyof typeof REGIONS]}, with sources.`;
---
{isArticle ? (
<Base rail={d.category} railExclude={a.slug} breadcrumbs={crumbs} title={d.title} description={d.description} image={d.image ?? `/covers/${a.slug}.png`} type="article" jsonLd={jsonLd} active={d.category} noindex={d.draft} published={d.date} modified={d.updated ?? d.date}>
  <article class={`c-${d.category}`}>
    <header class="story-head">
      <span class="kicker"><a href={catHref(d.category)}>{categoryLabel(d.category)}</a>{d.format && <> &nbsp;·&nbsp; {d.format}</>} &nbsp;·&nbsp; {d.region !== 'south' ? <a href={stateHref(d.region)}>{REGIONS[d.region as keyof typeof REGIONS]}</a> : REGIONS[d.region as keyof typeof REGIONS]}</span>
      <h1>{d.title}</h1>
      <p class="dek">{d.description}</p>
      <div class="by">
        <span class="avatar" aria-hidden="true">{initials}</span>
        <span>By <a href={byUrl}><b>{d.author}</b></a>{who && <> · {who.desk}</>}</span>
        <span>{fmtDate(d.date)}{d.updated ? `, updated ${fmtDate(d.updated)}` : ''}</span>
        <span>{mins} min read</span>
      </div>
    </header>
    {d.draft && <div class="draftbox"><b>DRAFT, not public.</b> {d.reviewNote ?? 'Review before publishing.'}</div>}
    <figure class="story-hero" style="margin-bottom:0">
      <StoryImg slug={a.slug} alt={d.imageAlt ?? d.title} eager />
      <figcaption class="caption">Illustration: Southwala</figcaption>
    </figure>
    <div class="story-body">
      {d.tldr && <div class="tldr"><b>In short</b>{d.tldr}</div>}
      <div class="prose"><Content /></div>
      <div class="share">
        <a class="btn" href={`https://wa.me/?text=${share}`} rel="noopener" target="_blank">Share on WhatsApp</a>
        <a class="btn" href={`https://twitter.com/intent/tweet?text=${share}`} rel="noopener" target="_blank">Post on X</a>
      </div>
    </div>
    <div class="notes">
      {d.sources.length > 0 && <details class="note" open><summary>Sources</summary><ul style="margin-top:12px">{d.sources.map((s: any) => <li><a href={s.url} rel="noopener nofollow" target="_blank">{s.title}</a>, {s.publisher}</li>)}</ul></details>}
      <div class="note"><h4>About this byline</h4>{d.author} is an AI-assisted Southwala desk byline{who ? ` for the ${who.desk}` : ''}. Stories are drafted from the cited sources with AI help and published under our <a href="/editorial-policy/">editorial policy</a>. <a href="/team/">How our desks work</a>.</div>
      <div class="note"><h4>Right of reply</h4>Named in this story and want to respond? Write to {SITE.email}. We will add your response, unedited, and update this story. <a href="/right-of-reply/">How it works</a>.</div>
    </div>
  </article>
  {props.related.length >= 2 && (
    <section class="more"><div class="sect"><h2>More {categoryLabel(d.category)}</h2></div><div class="three">{props.related.map((r: any) => <Card a={r} />)}</div></section>
  )}
</Base>
) : (
<Base rail={isCat ? props.id : 'general'} title={isCat ? sec!.brand : listTitle} description={isCat ? `${blurb}. Latest ${sec!.label} stories from Andhra Pradesh, Telangana, Karnataka, Tamil Nadu and Kerala, with sources.` : blurb} active={isCat ? props.id : undefined} breadcrumbs={[{ name: isCat ? sec!.label : listTitle, href: isCat ? sec!.href : stateHref(props.code) }]}>
  <div class={`page ${isCat ? `c-${props.id}` : ''}`}>
    <h1>{isCat ? sec!.tag : listTitle}</h1>
    <p class="dek" style="margin-bottom:30px;max-width:60ch">{isCat ? `Stories from Andhra Pradesh, Telangana, Karnataka, Tamil Nadu and Kerala, with sources on every one.` : blurb}</p>
    <div class="three">{items.map((x: any) => <Card a={x} />)}</div>
  </div>
</Base>
)}
