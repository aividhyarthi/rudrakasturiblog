---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import StoryImg from '../components/StoryImg.astro';
import LatestList from '../components/LatestList.astro';
import { allArticles, categoryLabel, fmtDate, findAuthor, sectionCounts } from '../lib/articles';
import { SITE, REGIONS, REGION_SLUG, CAT_SLUG, CATEGORIES, CAT_SECTION, CAT_RAIL, NEWS_CATS, SECTIONS, catHref, stateHref } from '../config';

// One route serves stories, plus section and state pages that exist only once they have stories.
export async function getStaticPaths() {
  const all = await allArticles({ includeHidden: true });
  const paths: any[] = all.map((a) => ({ params: { slug: a.slug }, props: { type: 'article', a, related: all.filter((x) => x.slug !== a.slug && x.data.category === a.data.category).slice(0, 3) } }));
  const counts = { cat: {} as Record<string, number>, region: {} as Record<string, number> };
  for (const x of all) { counts.cat[x.data.category] = (counts.cat[x.data.category] ?? 0) + 1; counts.region[x.data.region] = (counts.region[x.data.region] ?? 0) + 1; }
  for (const c of CATEGORIES) {
    if (c.id === 'politics') continue; // politics has its own hub page
    if (counts.cat[c.id]) paths.push({ params: { slug: CAT_SLUG[c.id] }, props: { type: 'category', id: c.id } });
  }
  for (const [code, slug] of Object.entries(REGION_SLUG)) if (counts.region[code]) paths.push({ params: { slug }, props: { type: 'state', code } });
  return paths;
}
const props = Astro.props as any;
const all = await allArticles({ includeHidden: true });
const isArticle = props.type === 'article';

// ---- article ----
let a: any, d: any, Content: any, jsonLd: any, byUrl = '', who: any, share = '', mins = 1, initials = '', crumbs: any[] = [];
if (isArticle) {
  a = props.a; d = a.data;
  Content = (await a.render()).Content;
  const url = `${SITE.url}/${a.slug}/`;
  who = null;
  byUrl = '/team/';
  mins = Math.max(1, Math.round(((a.body ?? '').split(/\s+/).length) / 210));
  initials = d.author.split(' ').map((w: string) => w[0]).slice(0, 2).join('');
  share = encodeURIComponent(`${d.title} ${url}`);
  const imgs = d.image ? [d.image] : ['16x9', '4x3', '1x1'].map((r) => `/img/${a.slug}/${r}.jpg`);
  jsonLd = {
    '@context': 'https://schema.org', '@type': NEWS_CATS.includes(d.category) ? 'NewsArticle' : 'Article', headline: d.title, description: d.description,
    image: imgs.map((u: string) => new URL(u, SITE.url).href), thumbnailUrl: new URL(imgs[0], SITE.url).href,
    inLanguage: 'en-IN', isAccessibleForFree: true, wordCount: (a.body ?? '').split(/\s+/).filter(Boolean).length,
    keywords: (d.tags ?? []).join(', '), datePublished: d.date.toISOString(), dateModified: (d.updated ?? d.date).toISOString(),
    author: { '@type': 'Organization', name: d.author, url: `${SITE.url}${byUrl}` },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url, logo: { '@type': 'ImageObject', url: `${SITE.url}/logo.png` } },
    mainEntityOfPage: url, articleSection: categoryLabel(d.category),
  };
  crumbs = [{ name: categoryLabel(d.category), href: catHref(d.category) }, { name: d.title, href: `/${a.slug}/` }];
}
// ---- section / state list ----
const isCat = props.type === 'category';
const cat = isCat ? CATEGORIES.find((c) => c.id === props.id)! : null;
const sec = isCat ? SECTIONS.find((s) => s.id === CAT_SECTION[props.id])! : null;
const isNews = isArticle ? NEWS_CATS.includes(d.category) : isCat ? NEWS_CATS.includes(props.id) : true;
const listTitle = isCat ? `${cat!.label}: ${cat!.blurb}` : `${REGIONS[props.code as keyof typeof REGIONS]} news`;
const items = isArticle ? [] : all.filter((x) => (isCat ? x.data.category === props.id : x.data.region === props.code));
const blurb = isCat ? cat!.blurb : `Politics, cinema and OTT from ${REGIONS[props.code as keyof typeof REGIONS]}, with sources.`;
---
{isArticle ? (
<Base rail={CAT_RAIL[d.category]} railExclude={a.slug} breadcrumbs={crumbs} title={d.title} description={d.description} image={d.image ?? `/share/${a.slug}.jpg`} imageW={d.image ? 1200 : 1200} imageH={d.image ? 675 : 630} imageAlt={d.imageAlt ?? d.title} section={categoryLabel(d.category)} tags={d.tags} author={d.author} type="article" jsonLd={jsonLd} active={CAT_SECTION[d.category]} noindex={d.draft} published={d.date} modified={d.updated ?? d.date}>
  <article class={`c-${d.category}`}>
    <header class="story-head">
      <span class="kicker"><a href={catHref(d.category)}>{categoryLabel(d.category)}</a>{d.format && <> &nbsp;·&nbsp; {d.format}</>} {isNews && <> &nbsp;·&nbsp; {d.region !== 'south' ? <a href={stateHref(d.region)}>{REGIONS[d.region as keyof typeof REGIONS]}</a> : REGIONS[d.region as keyof typeof REGIONS]}</>}</span>
      <h1>{d.title}</h1>
      <p class="dek">{d.description}</p>
      <div class="by">
        <span class="avatar" aria-hidden="true">{initials}</span>
        <span>By <a href={byUrl}><b>{d.author}</b></a></span>
        <span>{fmtDate(d.date)}{d.updated ? `, updated ${fmtDate(d.updated)}` : ''}</span>
        <span>{mins} min read</span>
      </div>
    </header>
    {d.draft && <div class="draftbox"><b>DRAFT, not public.</b> {d.reviewNote ?? 'Review before publishing.'}</div>}
    <figure class="story-hero" style="margin-bottom:0">
      <StoryImg slug={a.slug} alt={d.imageAlt ?? d.title} eager />
      <figcaption class="caption">Illustration: Southwala</figcaption>
    </figure>
    <div class="story-body">
      {d.tldr && <div class="tldr"><b>In short</b>{d.tldr}</div>}
      <div class="prose"><Content /></div>
      {d.faq.length > 0 && <section class="faq"><h2>Quick answers</h2>{d.faq.map((f: any) => <><h3>{f.q}</h3><p>{f.a}</p></>)}</section>}
      {d.faq.length > 0 && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map((f: any) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) })} />}
      <div class="share">
        <a class="btn" href={`https://wa.me/?text=${share}`} rel="noopener" target="_blank">Share on WhatsApp</a>
        <a class="btn" href={`https://twitter.com/intent/tweet?text=${share}`} rel="noopener" target="_blank">Post on X</a>
      </div>
    </div>
    <div class="notes">
      {d.sources.length > 0 && <details class="note" open><summary>Sources</summary><ul style="margin-top:12px">{d.sources.map((s: any) => <li><a href={s.url} rel="noopener nofollow" target="_blank">{s.title}</a>, {s.publisher}</li>)}</ul></details>}
      <div class="note"><h4>About this article</h4>Published by the {d.author} under our <a href="/editorial-policy/">editorial policy</a>. <a href="/team/">Our desks</a>.</div>
      <div class="note"><h4>Right of reply</h4>Named in this story and want to respond? Write to {SITE.email}. We will add your response, unedited, and update this story. <a href="/right-of-reply/">How it works</a>.</div>
    </div>
  </article>
  {props.related.length >= 2 && (
    <section class="more"><div class="sect"><h2>More {categoryLabel(d.category)}</h2></div><div class="three">{props.related.map((r: any) => <Card a={r} />)}</div></section>
  )}
</Base>
) : (
<Base rail={isCat ? CAT_RAIL[props.id] : 'general'} title={isCat ? `${cat!.label} Articles` : listTitle} description={isCat ? `${blurb} Articles from the Southwala ${cat!.label} desk.` : blurb} active={isCat ? CAT_SECTION[props.id] : undefined} breadcrumbs={[{ name: isCat ? cat!.label : listTitle, href: isCat ? catHref(props.id) : stateHref(props.code) }]}>
  <div class={`page ${isCat ? `c-${CAT_SECTION[props.id]}` : ''}`}>
    <h1>{isCat ? cat!.label : listTitle}</h1>
    <p class="dek" style="margin-bottom:30px;max-width:60ch">{blurb}</p>
    <div class="three">{items.map((x: any) => <Card a={x} />)}</div>
  </div>
</Base>
)}
