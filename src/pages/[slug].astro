---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { allArticles, categoryLabel, fmtDate, findAuthor, authorSlug } from '../lib/articles';
import { SITE, REGIONS } from '../config';
export async function getStaticPaths() {
  const all = await allArticles();
  return all.map((a) => ({ params: { slug: a.slug }, props: { a, related: all.filter((x) => x.slug !== a.slug && x.data.category === a.data.category).slice(0, 3) } }));
}
const { a, related } = Astro.props;
const { Content } = await a.render();
const d = a.data;
const who = findAuthor(d.author);
const byUrl = who ? `/author/${who.slug}/` : '/team/';
const img = d.image ?? `/covers/${a.slug}.png`;
const url = `${SITE.url}/${a.slug}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: d.title,
  description: d.description,
  image: [new URL(img, SITE.url).href],
  datePublished: d.date.toISOString(),
  dateModified: (d.updated ?? d.date).toISOString(),
  author: { '@type': 'Person', name: d.author, url: `${SITE.url}${who ? `/author/${who.slug}/` : '/team/'}`, description: 'AI-assisted Southwala desk byline' },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  mainEntityOfPage: url,
  articleSection: categoryLabel(d.category),
};
const share = encodeURIComponent(`${d.title} ${url}`);
---
<Base title={d.title} description={d.description} image={img} type="article" jsonLd={jsonLd} active={d.category} noindex={d.draft} published={d.date} modified={d.updated ?? d.date}>
  <article class="story">
    <span class="chip">{categoryLabel(d.category)}</span> {d.format && <span class="chip alt">{d.format}</span>} <span class="chip alt">{REGIONS[d.region]}</span>
    <h1>{d.title}</h1>
    <p class="dek">{d.description}</p>
    <div class="meta">By <a href={byUrl} style="text-decoration:underline">{d.author}</a>{who && <> · {who.desk}</>} · {fmtDate(d.date)}{d.updated ? ` · Updated ${fmtDate(d.updated)}` : ''}</div>
    {d.draft && <div class="box" style="border-color:var(--pink);color:var(--text)"><h4>DRAFT: not public</h4>{d.reviewNote ?? 'Review before publishing.'}</div>}
    <img class="hero-img" src={img} alt={d.imageAlt ?? d.title} width="1200" height="675" fetchpriority="high" />
    {d.tldr && <div class="tldr"><b>The 20-second version</b>{d.tldr}</div>}
    <div class="body"><Content /></div>
    <div class="share">
      <a class="btn wa" href={`https://wa.me/?text=${share}`} rel="noopener" target="_blank">Share on WhatsApp</a>
      <a class="btn x" href={`https://twitter.com/intent/tweet?text=${share}`} rel="noopener" target="_blank">Post on X</a>
    </div>
    {d.sources.length > 0 && (
      <div class="box"><h4>Receipts (sources)</h4><ul>{d.sources.map((s) => <li><a href={s.url} rel="noopener nofollow" target="_blank">{s.title}</a> &mdash; {s.publisher}</li>)}</ul></div>
    )}
    <div class="box"><h4>About this byline</h4>{d.author} is an AI-assisted Southwala desk byline{who ? ` for the ${who.desk}` : ''}. Stories are drafted from the cited sources with AI help and published under our <a href="/editorial-policy/" style="text-decoration:underline">editorial policy</a>. <a href="/team/" style="text-decoration:underline">How our desks work</a>.</div>
    <div class="box"><h4>Right of reply</h4>Named in this story and want to respond? Write to {SITE.email}. We will add your response, unedited, and update this story. <a href="/right-of-reply/" style="text-decoration:underline">How it works</a>.</div>
  </article>
  {related.length > 0 && <section class="sec"><header><h2>More {categoryLabel(d.category)}</h2></header><div class="grid">{related.map((r) => <Card a={r} />)}</div></section>}
</Base>
