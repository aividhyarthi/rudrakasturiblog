---
import LunarPage from '../../../components/LunarPage.astro';
import { permaPages } from '../../../lib/perma';
export function getStaticPaths() { return permaPages('amavasya').map((p) => ({ params: { slug: p.slug }, props: { l: p.primary, group: p.group } })); }
const { l, group } = Astro.props;
---
<LunarPage l={l} group={group} />
