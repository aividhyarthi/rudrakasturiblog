---
import Base from '../../layouts/Base.astro';
import { RASHIS, reading } from '../../lib/astro';
import { todayIST, addDays } from '../../lib/panchang';
export function getStaticPaths() { return RASHIS.map((r, i) => ({ params: { sign: r.id }, props: { i } })); }
const { i } = Astro.props as { i: number };
const r = RASHIS[i];
const today = todayIST();
const month = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const fd = (x: { y: number; m: number; d: number }) => `${x.d} ${month[x.m - 1]} ${x.y}`;
const tomorrow = addDays(today, 1);
const blocks = [
  { id: 'today', title: `Today, ${fd(today)}`, d: reading(i, today, 'daily') },
  { id: 'tomorrow', title: `Tomorrow, ${fd(tomorrow)}`, d: reading(i, tomorrow, 'daily') },
  { id: 'week', title: `This week, ${fd(today)} to ${fd(addDays(today, 6))}`, d: reading(i, today, 'weekly') },
  { id: 'month', title: `This month, ${fd(today)} to ${fd(addDays(today, 29))}`, d: reading(i, today, 'monthly') },
];
const star = (n: number) => '★'.repeat(n) + '☆'.repeat(5 - n);
---
<Base title={`${r.skt} Rashi Phalalu (${r.en}): Daily, Weekly, Monthly`} description={`${r.skt} (${r.te}) rashi phalalu: today, tomorrow, this week and this month, worked out from planetary transits.`} active="astrology">
  <div class="page" style="max-width:860px">
    <div class="kicker"><a href="/astrology/">Astrology</a> &nbsp;/&nbsp; Rashi Phalalu</div>
    <h1><span style="font-family:'Segoe UI Symbol','Noto Sans Symbols','DejaVu Sans',serif">{r.sym}</span> {r.skt} <span class="te">{r.te}</span> <span class="sub" style="font-weight:400">({r.en})</span></h1>
    <div class="chips" style="margin:6px 0 10px">{RASHIS.map((x) => <a href={`/astrology/${x.id}/`} class={x.id === r.id ? 'on' : ''}>{x.skt}</a>)}</div>
    <div class="chips" style="margin:0 0 6px">{blocks.map((b) => <a href={`#${b.id}`}>{b.title.split(',')[0]}</a>)}</div>
    {blocks.map((b) => (
      <section class="reading" id={b.id}>
        <h3>{b.title}</h3>
        <div class="stars" aria-label={`${b.d.rating} of 5`}>{star(b.d.rating)} <span class="sub" style="letter-spacing:0">({b.d.band})</span></div>
        <p style="font-size:18px;margin:8px 0">{b.d.summary}</p>
        <dl class="dl">
          {b.d.domains.map((x) => <><dt>{x.label}</dt><dd>{x.text}</dd></>)}
          <dt>Lucky colour</dt><dd>{b.d.lucky.color}</dd>
          <dt>Lucky number</dt><dd>{b.d.lucky.number}</dd>
        </dl>
        <div class="sub">Based on: {b.d.factors.join('; ')}.</div>
      </section>
    ))}
    <p class="disc">For entertainment and reflection only. These readings come from the day's planetary positions using traditional Vedic transit rules, the same for everyone born under {r.skt} rashi. They are not predictions about your life and not a substitute for medical, legal or financial advice. Your rashi is the sign of your Moon at birth.</p>
  </div>
</Base>
