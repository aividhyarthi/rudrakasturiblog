---
import Hero from '../../components/Hero.astro';
import Base from '../../layouts/Base.astro';
import { CHAPTERS } from '../../data/gita';
export function getStaticPaths() { return Array.from({ length: 18 }, (_, i) => ({ params: { chapter: `chapter-${i + 1}` }, props: { n: i + 1 } })); }
const { n } = Astro.props as { n: number };
const c = CHAPTERS[n - 1];
const prev = CHAPTERS[n - 2], next = CHAPTERS[n];
const url = `https://southwala.com/bhagavad-gita/chapter-${n}/`;
const jsonLd = { '@context': 'https://schema.org', '@type': 'Article', headline: `Bhagavad Gita Chapter ${n}: ${c.en}`, author: { '@type': 'Organization', name: 'Southwala' }, publisher: { '@type': 'Organization', name: 'Southwala', logo: { '@type': 'ImageObject', url: 'https://southwala.com/logo.png' } }, mainEntityOfPage: url, image: `https://southwala.com/covers/g-${n}.png`, dateModified: new Date().toISOString() };
---
<Base rail="religion" title={`Bhagavad Gita Chapter ${n}: ${c.en}`} description={`Bhagavad Gita Chapter ${n} (${c.skt}): a plain-English summary, the key ideas and the verses most often quoted.`} jsonLd={jsonLd} active="gita" breadcrumbs={[{ name: 'Religion', href: '/religion/' }, { name: 'Bhagavad Gita', href: '/bhagavad-gita/' }, { name: `Chapter ${n}`, href: `/bhagavad-gita/chapter-${n}/` }]} image={`/covers/g-${n}.png`}>
  <div class="page c-religion">
    <div class="kicker"><a href="/religion/">Religion</a> &nbsp;/&nbsp; <a href="/bhagavad-gita/">Bhagavad Gita</a></div>
    <h1>Bhagavad Gita Chapter {n}: {c.en}</h1>
    <Hero name="kurukshetra-dawn" alt="A chariot wheel, a bow and an open manuscript at dawn on the field of Kurukshetra" ratio="16/5" />
    <p class="meta" style="margin-top:0">{c.skt} &middot; {c.verses} verses</p>
    <div class="prose">
      {c.summary.map((p) => <p>{p}</p>)}
      <h2>Key ideas</h2>
      <ul>{c.ideas.map((i) => <li>{i}</li>)}</ul>
      {c.famous && (<><h2>Verses often quoted</h2><p>{c.famous}</p></>)}
    </div>
    <div class="chips" style="margin-top:18px">
      {prev && <a href={`/bhagavad-gita/chapter-${prev.n}/`}>&larr; Chapter {prev.n}</a>}
      <a href="/bhagavad-gita/">All chapters</a>
      {next && <a href={`/bhagavad-gita/chapter-${next.n}/`}>Chapter {next.n} &rarr;</a>}
    </div>
    <p class="disc">This summary is written in our own words to help you follow the chapter. It is not a translation. For the verses themselves, use a translation and commentary from a tradition or teacher you trust.</p>
  </div>
</Base>
