---
import Hero from '../../components/Hero.astro';
import Base from '../../layouts/Base.astro';
import { CHAPTERS, GITA_FAQ } from '../../data/gita';
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: GITA_FAQ.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
---
<Base title="Bhagavad Gita: All 18 Chapters Explained Simply (భగవద్గీత)" description="A plain guide to the Bhagavad Gita: summaries of all 18 chapters, the main ideas, the most quoted verses and answers to common questions." active="religion" breadcrumbs={[{ name: 'Religion', href: '/religion/' }, { name: 'Bhagavad Gita', href: '/bhagavad-gita/' }]} image="/covers/gita.png">
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <div class="page" style="max-width:820px">
    <div class="kicker"><a href="/religion/">Religion</a></div>
    <h1>Bhagavad Gita <span class="te">భగవద్గీత</span></h1>
    <Hero name="kurukshetra-dawn" alt="A chariot wheel, a bow and an open manuscript at dawn on the field of Kurukshetra" />
    <p class="dek">The Gita is a conversation between Krishna and Arjuna on the battlefield of Kurukshetra, set inside the Mahabharata. In 18 chapters it asks how to act well, how to find calm in a divided mind, and what it means to live with devotion and wisdom.</p>
    <p>This guide explains each chapter in plain words. The summaries are our own. For the verse-by-verse text, please use a translation and commentary from a tradition or teacher you trust.</p>
    <div class="sechead" style="margin-top:22px"><h2>The three paths in the Gita</h2></div>
    <ul>
      <li><b>Karma yoga</b>, the path of selfless action: do your work fully without clinging to the reward (Chapters 2 to 6).</li>
      <li><b>Bhakti yoga</b>, the path of devotion: love and surrender to the divine (Chapters 7 to 12).</li>
      <li><b>Jnana yoga</b>, the path of knowledge: understanding the Self, nature and the divine (Chapters 13 to 18).</li>
    </ul>
    <div class="sechead" style="margin-top:22px"><h2>All 18 chapters</h2></div>
    {CHAPTERS.map((c) => (
      <a class="item" href={`/bhagavad-gita/chapter-${c.n}/`}>
        <div class="kicker">Chapter {c.n}</div>
        <h3>{c.en} <span class="sub" style="font-weight:400">({c.skt})</span></h3>
        <p>{c.summary[0]}</p>
      </a>
    ))}
    <div class="sechead" style="margin-top:22px"><h2>Common questions</h2></div>
    {GITA_FAQ.map(([q, a]) => <><h3 style="margin-bottom:2px">{q}</h3><p style="margin-top:0">{a}</p></>)}
  </div>
</Base>
