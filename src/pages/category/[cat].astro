---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import Sidebar from '../../components/Sidebar.astro';
import { allArticles } from '../../lib/articles';
import { CATEGORIES } from '../../config';
export function getStaticPaths() { return CATEGORIES.map((c) => ({ params: { cat: c.id }, props: { c } })); }
const { c } = Astro.props;
const items = (await allArticles()).filter((a) => a.data.category === c.id);
---
<Base title={c.label} description={c.blurb} active={c.id}>
  <div class="art">
    <div>
      <div class="sechead"><h2>{c.label}</h2></div>
      <p class="meta" style="font-size:15px;margin:-4px 0 16px">{c.blurb}</p>
      {items.length ? <div>{items.map((a) => <Card a={a} />)}</div> : <div class="empty">Nothing here yet. Check back soon.</div>}
    </div>
    <Sidebar />
  </div>
</Base>
