---
import Base from '../layouts/Base.astro';
import LocalCard from '../components/LocalCard.astro';
import Glyph from '../components/Glyph.astro';
import { heroSrc } from '../lib/heroes';
import { RASHIS, reading } from '../lib/astro';
import { todayIST, ymdKey, WEEKDAYS } from '../lib/panchang';
import { allLunations, EN_MONTH_NAMES } from '../lib/lunar';
const ymd = todayIST();
const star = (n: number) => '★'.repeat(n) + '☆'.repeat(5 - n);
const signs = RASHIS.map((r, i) => ({ r, d: reading(i, ymd, 'daily') }));
const tk = ymdKey(ymd);
const nextAm = allLunations('amavasya').find((x) => x.key >= tk);
const nextPo = allLunations('pournami').find((x) => x.key >= tk);
const nice = (x: { weekday: number; observed: { y: number; m: number; d: number } }) => `${WEEKDAYS[x.weekday].slice(0, 3)}, ${x.observed.d} ${EN_MONTH_NAMES[x.observed.m - 1].slice(0, 3)} ${x.observed.y}`;
---
<Base home image="/covers/home.png">
  <section class="wrap lead-grid">
    <div>
      <span class="kicker" style="color:#b4530a">Devotional</span>
      <h1 style="font-size:clamp(30px,4vw,48px);line-height:1.06;letter-spacing:-.02em;margin:10px 0 12px">Today's panchangam, Rahu Kalam and rasi phalalu</h1>
      <p class="dek" style="max-width:60ch;margin:0 0 22px">Timings worked out from the real sky, for your own location. Plus Amavasya and Pournami dates, temple guides and the Bhagavad Gita in plain words.</p>
      <LocalCard />
      <div class="chips"><a class="btn solid" href="/panchangam/">Full panchangam</a><a class="btn" href="/rahu-kalam-today/">Rahu Kalam today</a><a class="btn" href="/horoscope-tomorrow/">Horoscope tomorrow</a></div>
    </div>
    <aside>
      <div class="sect"><h2>Coming up</h2></div>
      <div class="rail-links">
        {nextPo && <a href={`/pournami/${nextPo.slug}/`}><b>Next Pournami</b><br />{nice(nextPo)}<br /><small>{nextPo.occasion}</small></a>}
        {nextAm && <a href={`/amavasya/${nextAm.slug}/`}><b>Next Amavasya</b><br />{nice(nextAm)}<br /><small>{nextAm.occasion}</small></a>}
        <a href="/horoscope-tomorrow/"><b>Horoscope tomorrow</b><br /><small>All 12 rashis</small></a>
        <a href="/bhagavad-gita/"><b>Bhagavad Gita</b><br /><small>All 18 chapters explained</small></a>
      </div>
    </aside>
  </section>

  <section class="band band-astro c-astrology">
    <div class="wrap" style="grid-template-columns:1fr">
      <div style="max-width:640px">
        <span class="kicker">Astrology</span>
        <h2>Rasi phalalu, from the real sky</h2>
        <p class="lede">Daily, weekly and monthly readings for every rashi, worked out from today's actual planetary positions using the classical transit rules.</p>
      </div>
      <div class="sign-tiles">
        {signs.map(({ r, d }) => (
          <a class="sign-tile" href={`/rasi-phalalu/${r.id}/`}><Glyph id={r.id} size={34} /><b>{r.skt}</b><span class="stars">{star(d.rating)}</span></a>
        ))}
      </div>
      <div class="chips"><a class="btn solid" href="/rasi-phalalu/">Today</a><a class="btn" href="/horoscope-tomorrow/">Tomorrow</a><a class="btn" href="/rasi-phalalu/mesha/weekly/">Weekly</a><a class="btn" href="/rasi-phalalu/mesha/monthly/">Monthly</a></div>
    </div>
  </section>

  <section class="band band-dev c-religion">
    <div class="wrap">
      <div>
        <span class="kicker">Temples</span>
        <h2>The temples every pilgrim asks about</h2>
        <p class="lede">Complete lists of the 12 Jyotirlingas, 18 Maha Shakti Peethas, Char Dham and Pancharama Kshetralu, plus guides to major temples with history, festivals and what to check before you go.</p>
        <div class="chips">
          <a class="btn solid" href="/temples/">All temples</a>
          <a class="btn" href="/temples/jyotirlingas/">Jyotirlingas</a>
          <a class="btn" href="/temples/shakti-peethas/">Shakti Peethas</a>
          <a class="btn" href="/temples/char-dham/">Char Dham</a>
        </div>
      </div>
      <div class="imgwrap"><img src={heroSrc('temple-sunrise')} alt="A South Indian temple at sunrise with a row of lit lamps" width="1600" height="900" loading="lazy" /></div>
    </div>
  </section>

  <section class="wrap" style="padding:48px 0 56px">
    <div class="three" style="grid-template-columns:repeat(2,1fr)">
      {nextPo && <a class="rcard c-religion" href="/pournami/" style="display:block;text-decoration:none;color:inherit"><small style="text-transform:uppercase;letter-spacing:.06em;color:#6b6b6b">Pournami</small><b style="display:block;font-size:24px;margin:4px 0">{nice(nextPo)}</b><span>{nextPo.occasion}. All Pournami dates and tithi timings &rarr;</span></a>}
      {nextAm && <a class="rcard c-religion" href="/amavasya/" style="display:block;text-decoration:none;color:inherit"><small style="text-transform:uppercase;letter-spacing:.06em;color:#6b6b6b">Amavasya</small><b style="display:block;font-size:24px;margin:4px 0">{nice(nextAm)}</b><span>{nextAm.occasion}. All Amavasya dates and tithi timings &rarr;</span></a>}
    </div>
    <div class="sect" style="margin-top:36px"><h2>Bhagavad Gita, chapter by chapter</h2><a href="/bhagavad-gita/">All 18</a></div>
    <div class="chips"><a href="/bhagavad-gita/chapter-1/">Chapter 1</a><a href="/bhagavad-gita/chapter-2/">Chapter 2: Sankhya Yoga</a><a href="/bhagavad-gita/chapter-12/">Chapter 12: Bhakti Yoga</a><a href="/bhagavad-gita/chapter-18/">Chapter 18</a></div>
  </section>
</Base>
