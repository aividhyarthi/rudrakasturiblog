---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { allArticles, categoryLabel } from '../lib/articles';
import { CATEGORIES } from '../config';
const all = await allArticles();
const [lead, ...rest] = all;
const trending = rest.slice(0, 5);
const latest = rest.slice(5, 14);
---
<Base>
  {!lead ? (
    <div class="empty"><h1>First stories dropping soon.</h1><p>The newsroom is warming up.</p></div>
  ) : (
    <>
      <section class="hero">
        <a class="lead" href={`/${lead.slug}/`}>
          <img src={lead.data.image ?? `/covers/${lead.slug}.png`} alt={lead.data.imageAlt ?? lead.data.title} width="1200" height="675" fetchpriority="high" />
          <div class="in">
            <span class="chip">{categoryLabel(lead.data.category)}</span>
            <h1>{lead.data.title}</h1>
            <p style="margin:0;color:#ddd">{lead.data.description}</p>
          </div>
        </a>
        <aside class="side">
          <h2>Trending now</h2>
          {trending.map((a, i) => (
            <div class="rank"><span>{i + 1}</span><a href={`/${a.slug}/`}>{a.data.title}<div class="meta">{categoryLabel(a.data.category)}</div></a></div>
          ))}
        </aside>
      </section>
      {latest.length > 0 && (
        <section class="sec">
          <header><h2>Latest</h2></header>
          <div class="grid">{latest.map((a) => <Card a={a} />)}</div>
        </section>
      )}
      {CATEGORIES.map((c) => {
        const items = all.filter((a) => a.data.category === c.id).slice(0, 3);
        return items.length ? (
          <section class="sec">
            <header><h2>{c.label}</h2><a class="meta" href={`/category/${c.id}/`}>See all &rarr;</a></header>
            <div class="grid">{items.map((a) => <Card a={a} />)}</div>
          </section>
        ) : null;
      })}
    </>
  )}
</Base>
