---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import Row from '../components/Row.astro';
import StoryImg from '../components/StoryImg.astro';
import LatestList from '../components/LatestList.astro';
import Glyph from '../components/Glyph.astro';
import { heroSrc } from '../lib/heroes';
import { allArticles, categoryLabel, fmtDate, sectionCounts, byline } from '../lib/articles';
import { CATEGORIES, catHref } from '../config';
import { RASHIS, reading } from '../lib/astro';
import { panchangFor, fmtTime, todayIST } from '../lib/panchang';
const all = await allArticles();
const [lead, ...rest] = all;
const ymd = todayIST();
const p = panchangFor(ymd, 'hyderabad');
const ref = new Date(Date.UTC(ymd.y, ymd.m - 1, ymd.d));
const t = (d: Date) => fmtTime(d, ref);
const star = (n: number) => '★'.repeat(n) + '☆'.repeat(5 - n);
const signs = RASHIS.map((r, i) => ({ r, d: reading(i, ymd, 'daily') }));
const counts = await sectionCounts();
// Each story appears once: lead, then the latest list, then a card row, then section columns for what is left.
const latestN = rest.length <= 5 ? rest.length : 4;
const shownTop = new Set([lead?.slug, ...rest.slice(0, latestN).map((a) => a.slug)]);
// The card row only appears when it has at least two stories; otherwise they flow into the section columns.
let grid = rest.slice(latestN, latestN + 3);
if (grid.length < 2) grid = [];
grid.forEach((a) => shownTop.add(a.slug));
const cols = CATEGORIES.filter((c) => counts.cat[c.id]).map((c) => ({ s: { id: c.id, label: c.label, href: catHref(c.id) }, items: all.filter((a) => a.data.category === c.id && !shownTop.has(a.slug)).slice(0, 3) })).filter((x) => x.items.length);
const leftover = cols.reduce((n, c) => n + c.items.length, 0);
---
<Base home image="/covers/home.png">
  {!lead ? (
    <div class="empty"><h1>First stories dropping soon.</h1></div>
  ) : (
    <section class="wrap lead-grid">
      <a class={`lead c-${lead.data.category}`} href={`/${lead.slug}/`}>
        <div class="imgwrap"><StoryImg slug={lead.slug} alt={lead.data.imageAlt ?? lead.data.title} eager /></div>
        <span class="kicker">{categoryLabel(lead.data.category)}</span>
        <h1>{lead.data.title}</h1>
        <p>{lead.data.description}</p>
        <div class="meta">{byline(lead.data)} · {fmtDate(lead.data.date)}</div>
      </a>
      <LatestList exclude={[lead.slug]} limit={latestN} title="Latest" />
    </section>
  )}
  {grid.length > 0 && (
    <section class="wrap" style="padding-bottom:56px">
      <div class="sect"><h2>More stories</h2></div>
      <div class="three" style={`grid-template-columns:repeat(${grid.length},1fr)`}>{grid.map((a) => <Card a={a} />)}</div>
    </section>
  )}

  <section class="band band-dev c-religion">
    <div class="wrap">
      <div>
        <span class="kicker">Devotional</span>
        <h2>Today's Panchangam</h2>
        <p class="lede">Tithi, nakshatra, Rahu Kalam and the good timings, calculated for your location. Plus guides to the temples every pilgrim asks about, and the Bhagavad Gita, chapter by chapter.</p>
        <div class="facts">
          <div class="fact"><b>Tithi</b><span data-local="tithi">{p.tithi[0].paksha} {p.tithi[0].name}</span><small>until {t(p.tithi[0].endsAt)}</small></div>
          <div class="fact"><b>Nakshatra</b><span data-local="nakshatra">{p.nakshatra[0].name}</span><small>until {t(p.nakshatra[0].endsAt)}</small></div>
          <div class="fact"><b>Rahu Kalam</b><span data-local="rahu">{t(p.rahu.start)} to {t(p.rahu.end)}</span><small data-local="name">Hyderabad</small></div>
          <div class="fact"><b>Abhijit</b><span data-local="abhijit">{t(p.abhijit.start)} to {t(p.abhijit.end)}</span><small>Good time to begin</small></div>
        </div>
        <div class="chips">
          <a class="btn solid" href="/panchangam/">Today's panchangam</a>
          <a class="btn" href="/daily-panchangam/">Daily article</a>
          <a class="btn" href="/mantras/">Mantras</a>
          <a class="btn" href="/amavasya/">Amavasya</a>
          <a class="btn" href="/pournami/">Pournami</a>
          <a class="btn" href="/temples/">Temples</a>
          <a class="btn" href="/bhagavad-gita/">Bhagavad Gita</a>
        </div>
      </div>
      <div class="imgwrap"><img src={heroSrc('temple-sunrise')} alt="A South Indian temple at sunrise with a row of lit lamps" width="1600" height="900" loading="lazy" /></div>
    </div>
  </section>

  <section class="band band-astro c-astrology">
    <div class="wrap" style="grid-template-columns:1fr">
      <div style="max-width:640px">
        <span class="kicker">Astrology</span>
        <h2>Rasi phalalu for every rashi</h2>
        <p class="lede">Daily, weekly and monthly horoscopes for all twelve rashis, calculated from the day's planetary positions using the classical Vedic transit rules.</p>
      </div>
      <div class="sign-tiles">
        {signs.map(({ r, d }) => (
          <a class="sign-tile" href={`/rasi-phalalu/${r.id}/`}><Glyph id={r.id} size={34} /><b>{r.skt}</b><span class="stars">{star(d.rating)}</span></a>
        ))}
      </div>
      <div class="chips"><a class="btn solid" href="/rasi-phalalu/">Today</a><a class="btn" href="/daily-horoscope/">Daily article</a><a class="btn" href="/horoscope-tomorrow/">Tomorrow</a><a class="btn" href="/rasi-phalalu/mesha/weekly/">Weekly</a><a class="btn" href="/rasi-phalalu/mesha/monthly/">Monthly</a></div>
    </div>
  </section>

  {leftover >= 2 && (
    <section class="wrap" style="padding-top:56px">
      <div class="three" style={`grid-template-columns:repeat(${Math.min(cols.length, 3)},1fr)`}>
        {cols.map(({ s, items }) => (
          <div class={`c-${s.id}`}>
            <div class="sect"><h2>{s.label}</h2><a href={s.href}>More</a></div>
            {items.map((a) => <Row a={a} />)}
          </div>
        ))}
      </div>
    </section>
  )}
</Base>
