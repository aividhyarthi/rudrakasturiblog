---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import Row from '../components/Row.astro';
import StoryImg from '../components/StoryImg.astro';
import LatestList from '../components/LatestList.astro';
import Glyph from '../components/Glyph.astro';
import { heroSrc } from '../lib/heroes';
import { allArticles, categoryLabel, fmtDate, sectionCounts, seriesCounts, byline } from '../lib/articles';
import { CATEGORIES, catHref } from '../config';
import { RASHIS, reading } from '../lib/astro';
import { panchangFor, fmtTime, todayIST, addDays, WEEKDAYS } from '../lib/panchang';
import { shuffle, diversePick, slotNumber, dayNumber, isEvergreen } from '../lib/rotate';
import { niceDate, ymdKey, dayFacts } from '../lib/daily';
import { WEEKDAY_FEATURE, WEEKDAY_ROTA } from '../data/weekday';
import { SERIES, seriesHref } from '../config';
import { allTithis, ROUTE } from '../lib/tithi';
import { allLunations } from '../lib/lunar';
import { upcomingFestivals, festivalsByKey } from '../lib/festivals';
import { GODS, godMatches } from '../data/gods';
import MasaBanner from '../components/MasaBanner.astro';
const all = await allArticles();
const ymd = todayIST();
const p = panchangFor(ymd, 'hyderabad');
const ref = new Date(Date.UTC(ymd.y, ymd.m - 1, ymd.d));
const t = (d: Date) => fmtTime(d, ref);
const star = (n: number) => '★'.repeat(n) + '☆'.repeat(5 - n);
const signs = RASHIS.map((r, i) => ({ r, d: reading(i, ymd, 'daily') }));
const counts = await sectionCounts();
// The home page rotates: the same day always gives the same picks, and each daily rebuild shows a fresh mix,
// so older stories and every series get their turn. Each story appears once.
const seed = slotNumber();
const bySlug = new Map(all.map((a) => [a.slug, a]));
const facts = dayFacts(ymd);
const wk = WEEKDAY_FEATURE[facts.wd];
// The weekday's god changes form every week (a different goddess each Friday), and the story is picked from that god's articles.
const week = Math.floor(dayNumber() / 7);
const rota = WEEKDAY_ROTA[facts.wd];
let rotaGod = rota[0], wkLead: (typeof all)[number] | undefined;
for (let i = 0; i < rota.length && !wkLead; i++) {
  const g = rota[(week + i) % rota.length];
  const pool = all.filter((a) => isEvergreen(a.slug) && g.kw.some((k) => a.slug.includes(k)));
  if (pool.length) { rotaGod = g; wkLead = shuffle(pool, week * 7 + facts.wd)[0]; }
}
const wkMore: typeof all = [];
// Lead: the day's own story (Saturday is Balaji), otherwise a rotating pick from the last day and a half.
const fresh = all.filter((a) => Date.now() - a.data.date.getTime() < 36 * 3600000 && a !== wkLead);
const lead = wkLead && (seed % 2 === 0 || !fresh.length) ? wkLead : fresh.length ? shuffle(fresh, seed)[0] : (wkLead ?? all[0]);
const rest = all.filter((a) => a !== lead);
// Today's three daily pages, with titles that say what is in them.
const tomorrow = addDays(ymd, 1);
const tf = dayFacts(tomorrow);
const rank = (d: typeof ymd) => RASHIS.map((r, i) => ({ r, s: reading(i, d, 'daily').rating })).sort((x, y) => y.s - x.s);
const todayRank = rank(ymd), tomRank = rank(tomorrow);
const names = (xs: { r: { skt: string } }[]) => `${xs[0].r.skt} and ${xs[1].r.skt}`;
const key = ymdKey(ymd);
const dailyExtras = [
  { kicker: 'Horoscope today', title: `${WEEKDAYS[facts.wd]}: a good day for ${names(todayRank)}, go slowly if you are ${todayRank[11].r.skt}`, href: `/daily-horoscope/${key}/`, meta: `Moon in ${facts.moonSign.skt}, ${facts.nak.name} nakshatra. All 12 rashis`, cls: 'c-astrology' },
  { kicker: 'Panchangam today', title: `${WEEKDAYS[facts.wd]}: ${facts.tithi.paksha} ${facts.tithi.name}, Rahu Kalam ${facts.range(facts.p.rahu)}`, href: `/daily-panchangam/${key}/`, meta: `Abhijit ${facts.range(facts.p.abhijit)}. The god and mantra of the day`, cls: 'c-religion' },
  { kicker: 'Horoscope tomorrow', title: `${WEEKDAYS[tf.wd]}: Moon in ${tf.moonSign.skt}, best for ${names(tomRank)}`, href: '/horoscope-tomorrow/', meta: `${niceDate(tomorrow)}. Plan the day ahead`, cls: 'c-astrology' },
];
const latestArts = [...wkMore, ...rest.filter((a) => !wkMore.includes(a))].slice(0, 3);
const shownTop = new Set([lead?.slug, ...latestArts.map((a) => a.slug)]);
// "Worth reading again": older stories from different series and topics (Why me?, the Gita, Upanishads, temples, yoga...),
// a new mix at every refresh, so the page always carries evergreen reading and not only the newest.
const older = rest.filter((a) => !shownTop.has(a.slug) && Date.now() - a.data.date.getTime() > 2 * 86400000);
let grid = diversePick(older.length >= 6 ? older : rest.filter((a) => !shownTop.has(a.slug)), 6, seed);
if (grid.length < 3) grid = [];
if (grid.length > 3 && grid.length < 6) grid = grid.slice(0, 3);
grid.forEach((a) => shownTop.add(a.slug));
// The Gita and the Upanishads: always some of the best teaching on the page.
const isTeaching = (a: any) => a.data.category === 'gita' || a.data.series === 'read-the-line' || /upanishad/i.test(`${a.data.title} ${(a.data.tags ?? []).join(' ')}`);
let teach = diversePick(all.filter((a) => isTeaching(a) && !shownTop.has(a.slug)), 3, seed + 5);
if (teach.length < 2) teach = [];
teach.forEach((a) => shownTop.add(a.slug));
// Series to follow: a few series each day, each showing where to start or what is new.
const sc = await seriesCounts();
const seriesTiles = shuffle(SERIES.filter((s) => sc[s.id]), seed + 9).slice(0, 4).map((s) => ({ s, items: all.filter((a) => a.data.series === s.id).sort((x, y) => x.data.date.getTime() - y.data.date.getTime()) }));
// Special days in the next few weeks: Ekadashi, Pradosham, Sankashti, Amavasya and Pournami, each linked to its own date page.
const nowKey = ymdKey(ymd);
const dayRow = (o: { key: string; observed: { y: number; m: number; d: number }; weekday: number }, label: string, href: string, cls: string) => ({ key: o.key, label, href, cls, date: `${WEEKDAYS[o.weekday]}, ${o.observed.d} ${niceDate(o.observed).split(' ').find((w) => /^[A-Z][a-z]+$/.test(w) && !WEEKDAYS.includes(w)) ?? ''}` });
// The next date of every kind is always shown (Ekadashi, Sankashti, Pradosham, Amavasya, Pournami), then the next festivals fill the strip.
const nextOf = [
  ...(['ekadashi', 'sankashti', 'pradosham'] as const).map((k) => { const o = allTithis(k).find((x) => x.key >= nowKey); return o ? dayRow(o, o.name, `/${ROUTE[k]}/${o.slug}/`, 'c-religion') : null; }),
  ...(['amavasya', 'pournami'] as const).map((k) => { const o = allLunations(k).find((x) => x.key >= nowKey); return o ? dayRow(o, o.occasion ?? (k === 'amavasya' ? 'Amavasya' : 'Pournami'), `/${k}/${o.slug}/`, 'c-religion') : null; }),
].filter(Boolean) as ReturnType<typeof dayRow>[];
const festRows = upcomingFestivals(ymd, 6).map((f) => dayRow({ key: f.key, observed: f.ymd, weekday: f.weekday }, f.name, `/festivals/${f.slug}/`, 'c-religion')).filter((f) => !nextOf.some((n) => n.href === f.href)).slice(0, 4);
const specialDays = [...nextOf, ...festRows].sort((a, b) => a.key.localeCompare(b.key));
// Explore by god: every god page that has at least three stories.
const godTiles = GODS.map((g) => ({ g, n: all.filter((a) => godMatches(g, a)).length })).filter((x) => x.n >= 3);
// Untold stories of the epics, the rishis and the saints, from the newest series.
const untoldSeries = ['mahabharata-stories', 'ramayana-stories', 'rishis-and-texts', 'saints-of-the-south', 'goddess-stories', 'deepavali-hidden-stories'];
let untold = diversePick(all.filter((a) => untoldSeries.includes(a.data.series ?? '') && !shownTop.has(a.slug)), 6, seed + 13);
if (untold.length < 3) untold = [];
untold.forEach((a) => shownTop.add(a.slug));
// "More to read": one mixed block in place of four short columns.
const more = diversePick(all.filter((a) => !shownTop.has(a.slug)), 8, seed + 21);
more.forEach((a) => shownTop.add(a.slug));
const catChips = CATEGORIES.filter((c) => counts.cat[c.id]);
// A first set for "Keep exploring"; visitors can shuffle for more without waiting for a rebuild.
const explore0 = diversePick(all.filter((a) => !shownTop.has(a.slug)), 6, seed + 33);
const todayFest = festivalsByKey().get(nowKey) ?? [];
---
<Base home image="/covers/home.png">
  {!lead ? (
    <div class="empty"><h1>First stories dropping soon.</h1></div>
  ) : (
    <section class="wrap lead-grid">
      <a class={`lead c-${lead.data.category}`} href={`/${lead.slug}/`}>
        <div class="imgwrap"><StoryImg slug={lead.slug} alt={lead.data.imageAlt ?? lead.data.title} eager /></div>
        <span class="kicker">{lead === wkLead ? `${wk.name}: ${rotaGod.god}` : categoryLabel(lead.data.category)}</span>
        <h1>{lead.data.title}</h1>
        <p>{lead.data.description}</p>
        <div class="meta">{byline(lead.data)} · {fmtDate(lead.data.date)}</div>
      </a>
      <LatestList items={latestArts} extras={dailyExtras} title="Latest" />
    </section>
  )}
  <MasaBanner ymd={ymd} />
  {specialDays.length > 0 && (
    <section class="wrap" style="padding-top:36px">
      <div class="sect"><h2>Special days coming up</h2><a href="/festivals/">All festivals</a> <a href="/calendar/">Calendar 2027 (PDF)</a></div>
      <div class="three" style="grid-template-columns:repeat(auto-fit,minmax(200px,1fr))">
        {specialDays.map((d) => <a class={d.cls} href={d.href} style="display:block;padding:14px 16px;border:1px solid var(--line,#e5e0d8);border-radius:10px"><b style="display:block">{d.label}</b><span style="color:#6b6b6b;font-size:.92rem">{d.date}</span></a>)}
      </div>
    </section>
  )}
  <section class="band band-dev c-religion">
    <div class="wrap">
      <div>
        <span class="kicker">Devotional</span>
        <h2>Today's Panchangam</h2>
        <p class="lede">Tithi, nakshatra, Rahu Kalam and the good timings, calculated for your location. Plus guides to the temples every pilgrim asks about, and the Bhagavad Gita, chapter by chapter.</p>
        <div class="facts">
          <div class="fact"><b>Tithi</b><span data-local="tithi">{p.tithi[0].paksha} {p.tithi[0].name}</span><small>until {t(p.tithi[0].endsAt)}</small></div>
          <div class="fact"><b>Nakshatra</b><span data-local="nakshatra">{p.nakshatra[0].name}</span><small>until {t(p.nakshatra[0].endsAt)}</small></div>
          <div class="fact"><b>Rahu Kalam</b><span data-local="rahu">{t(p.rahu.start)} to {t(p.rahu.end)}</span><small data-local="name">Hyderabad</small></div>
          <div class="fact"><b>Abhijit</b><span data-local="abhijit">{t(p.abhijit.start)} to {t(p.abhijit.end)}</span><small>Good time to begin</small></div>
          <div class="fact"><b>Amrit Kalam</b><span>{p.amrit.length ? p.amrit.map((r) => `${t(r.start)} to ${t(r.end)}`).join(', ') : 'None today'}</span><small>Amrita Ghadiya, good to begin anything</small></div>
          <div class="fact"><b>Varjyam</b><span>{p.varjyam.length ? p.varjyam.map((r) => `${t(r.start)} to ${t(r.end)}`).join(', ') : 'None today'}</span><small>Better to avoid new starts</small></div>
        </div>
        {todayFest.length > 0 && <div class="fest-today">{todayFest.map((f) => <a href={`/festivals/${f.slug}/`}><b>Today: {f.name}</b><span>{f.alt ?? f.god}</span></a>)}</div>}
        <div class="chips">
          <a class="btn solid" href="/panchangam/">Today's panchangam</a>
          <a class="btn" href="/daily-panchangam/">Daily article</a>
          <a class="btn" href={`/mantras/${facts.main.id}/`}>{facts.main.name} mantras</a><a class="btn" href="/mantras/">Mantras</a>
          <a class="btn" href="/amavasya/">Amavasya</a>
          <a class="btn" href="/pournami/">Pournami</a>
          <a class="btn" href="/temples/">Temples</a>
          <a class="btn" href="/bhagavad-gita/">Bhagavad Gita</a>
        </div>
      </div>
      <div class="imgwrap"><img src={heroSrc('temple-sunrise')} alt="A South Indian temple at sunrise with a row of lit lamps" width="1600" height="900" loading="lazy" /></div>
    </div>
  </section>

  <section class="band band-astro c-astrology">
    <div class="wrap" style="grid-template-columns:1fr">
      <div style="max-width:640px">
        <span class="kicker">Astrology</span>
        <h2>Rasi phalalu for every rashi</h2>
        <p class="lede">Daily, weekly and monthly horoscopes for all twelve rashis, calculated from the day's planetary positions using the classical Vedic transit rules.</p>
        <p class="lede" style="margin-top:6px"><b>Today, {WEEKDAYS[facts.wd]}:</b> Moon in {facts.moonSign.skt}. A good day for {names(todayRank)}; go slowly if you are {todayRank[11].r.skt}.</p>
      </div>
      <div class="sign-tiles">
        {signs.map(({ r, d }) => (
          <a class="sign-tile" href={`/rasi-phalalu/${r.id}/`}><Glyph id={r.id} size={34} /><b>{r.skt}</b><span class="stars">{star(d.rating)}</span></a>
        ))}
      </div>
      <div class="chips"><a class="btn solid" href="/rasi-phalalu/">Today</a><a class="btn" href="/daily-horoscope/">Daily article</a><a class="btn" href="/horoscope-tomorrow/">Tomorrow</a><a class="btn" href="/rasi-phalalu/mesha/weekly/">Weekly</a><a class="btn" href="/rasi-phalalu/mesha/monthly/">Monthly</a></div>
    </div>
  </section>

  {godTiles.length > 0 && (
    <section class="wrap" style="padding-top:56px">
      <div class="sect"><h2>Explore by god</h2><a href="/gods/">All gods</a></div>
      <div class="godgrid">{godTiles.map(({ g, n }) => <a href={`/gods/${g.id}/`}><b>{g.name}</b><span class="te">{g.te}</span><small>{n} stories</small></a>)}</div>
    </section>
  )}

  {grid.length > 0 && (
    <section class="wrap" style="padding-top:56px;padding-bottom:56px">
      <div class="sect"><h2>Worth reading again</h2></div>
      <div class="three" style="row-gap:28px">{grid.map((a) => <Card a={a} />)}</div>
    </section>
  )}

  {untold.length > 0 && (
    <section class="wrap" style="padding-bottom:56px">
      <div class="sect"><h2>Untold stories of the epics, the rishis and the saints</h2><a href="/series/">All series</a></div>
      <div class="three" style="row-gap:28px">{untold.map((a) => <Card a={a} big={false} />)}</div>
    </section>
  )}

  {teach.length > 0 && (
    <section class="wrap" style="padding-bottom:56px">
      <div class="sect"><h2>From the Gita and the Upanishads</h2><a href="/gita-teachings/">More</a></div>
      <div class={teach.length === 3 ? "three" : "three two"}>{teach.map((a) => <Card a={a} />)}</div>
    </section>
  )}
  {seriesTiles.length > 0 && (
    <section class="wrap" style="padding-bottom:56px">
      <div class="sect"><h2>Series to follow</h2><a href="/series/">All series</a> <a href="/topics/">All topics</a></div>
      <div class="tiles" style="display:grid;grid-template-columns:repeat(2,1fr);gap:16px">{seriesTiles.map(({ s, items }) => (
        <a class="tile" href={seriesHref(s.id)}><h3>{s.label}</h3><div class="meta">{s.blurb}</div><div class="meta" style="margin-top:8px">Latest: <b>{items[items.length - 1].data.title}</b> ({items.length} {items.length === 1 ? 'article' : 'articles'})</div></a>
      ))}</div>
    </section>
  )}

  <section class="wrap" style="padding-bottom:56px">
    <div class="sect"><h2>Keep exploring</h2><button type="button" class="btn" data-shuffle>Show me others</button></div>
    <div class="ex-grid" data-explore>{explore0.map((a) => <a href={`/${a.slug}/`}><small>{categoryLabel(a.data.category)}</small><span>{a.data.title}</span></a>)}</div>
  </section>

  {more.length > 0 && (
    <section class="wrap" style="padding-bottom:56px">
      <div class="sect"><h2>More to read</h2><a href="/topics/">All topics</a></div>
      <div class="two-col">{more.map((a) => <Row a={a} />)}</div>
      <div class="chips" style="margin-top:18px">{catChips.map((c) => <a href={catHref(c.id)}>{c.label}</a>)}</div>
    </section>
  )}
  <script>import '../scripts/explore';</script>
</Base>
