---
import Hero from '../../../components/Hero.astro';
import Base from '../../../layouts/Base.astro';
import PanchangView from '../../../components/PanchangView.astro';
import { CITIES, parseKey, WEEKDAYS, type CityId } from '../../../lib/panchang';
export function getStaticPaths() {
  const t = new Date(Date.now() + 5.5 * 3600 * 1000);
  const today = { y: t.getUTCFullYear(), m: t.getUTCMonth() + 1, d: t.getUTCDate() };
  const out: any[] = [];
  for (const city of ['hyderabad', 'visakhapatnam', 'vijayawada', 'tirupati', 'bengaluru', 'chennai', 'kochi']) {
    for (let i = -2; i <= 45; i++) {
      const x = new Date(Date.UTC(today.y, today.m - 1, today.d + i));
      out.push({ params: { city, date: `${x.getUTCFullYear()}-${String(x.getUTCMonth() + 1).padStart(2, '0')}-${String(x.getUTCDate()).padStart(2, '0')}` } });
    }
  }
  return out;
}
const { city, date } = Astro.params as { city: CityId; date: string };
const ymd = parseKey(date);
const c = CITIES[city];
const pretty = `${WEEKDAYS[new Date(Date.UTC(ymd.y, ymd.m - 1, ymd.d)).getUTCDay()]}, ${ymd.d} ${['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'][ymd.m - 1]} ${ymd.y}`;
const crumbs = [{ name: 'Religion', href: '/religion/' }, { name: 'Panchangam', href: '/panchangam/' }, { name: c.name, href: `/panchangam/${city}/` }, { name: pretty, href: `/panchangam/${city}/${date}/` }];
---
<Base rail="religion" railNoToday title={`Panchangam ${c.name}, ${pretty.split(', ')[1]}: Rahu Kalam, Tithi`} description={`Panchangam for ${c.name} on ${pretty}: sunrise, sunset, tithi, nakshatra, yoga, karana, Rahu Kalam, Yamagandam, Abhijit and Brahma Muhurtham.`} active="religion" breadcrumbs={crumbs} image="/covers/panchangam.png">
  <div class="page wide">
    <div class="kicker"><a href="/religion/">Religion</a> &nbsp;/&nbsp; <a href="/panchangam/">Panchangam</a></div>
    <h1>Panchangam {c.name}: {pretty}</h1>
    <p class="meta" style="margin-top:0">{c.name}, {c.state}</p>
        <div class="chips" style="margin:10px 0 22px">
      {Object.entries(CITIES).map(([id, x]) => <a href={`/panchangam/${id}/${date}/`} class={id === city ? 'on' : ''}>{x.name}</a>)}
    </div>
    <PanchangView city={city} ymd={ymd} />
  </div>
</Base>
