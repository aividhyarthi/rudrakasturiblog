---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { allArticles } from '../../lib/articles';
const items = (await allArticles()).filter((a) => a.data.category === 'politics');
---
<Base title="Politics" description="Politics from Andhra Pradesh, Telangana, Karnataka, Tamil Nadu and Kerala, with sources and the receipts." active="politics">
  <div class="page" style="max-width:960px">
    <div class="sechead"><h2>Politics</h2></div>
    <div class="sechead"><h2>Political news and analysis</h2></div>
    {items.length ? <div>{items.map((a) => <Card a={a} />)}</div> : <div class="empty">No stories yet.</div>}
  </div>
</Base>
