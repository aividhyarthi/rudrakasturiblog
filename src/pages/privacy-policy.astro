---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
---
<Base title="Privacy policy" description="How Southwala handles data, cookies and ads.">
  <div class="page">
    <h1>Privacy policy</h1>
    <p>Southwala does not ask readers to create accounts. We collect only standard analytics data (pages viewed, device type, approximate location) to understand what readers like.</p>
    <h2>Cookies and ads</h2><p>We use Google Analytics and may show ads through Google AdSense. Google and its partners may use cookies to serve ads based on your visits to this and other sites. You can manage personalised ads at <a href="https://adssettings.google.com">adssettings.google.com</a>.</p>
    <h2>Affiliate links</h2><p>Some links may earn us a commission at no extra cost to you. Such links are labelled.</p>
    <h2>Contact</h2><p>Questions about privacy: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
  </div>
</Base>
