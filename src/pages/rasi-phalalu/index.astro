---
import Hero from '../../components/Hero.astro';
import Glyph from '../../components/Glyph.astro';
import Base from '../../layouts/Base.astro';
import { RASHIS, reading, dayOverall } from '../../lib/astro';
import { panchangFor, todayIST, WEEKDAYS } from '../../lib/panchang';
const ymd = todayIST();
const p = panchangFor(ymd, 'hyderabad');
const o = dayOverall({ tithi: p.tithi, nakshatra: p.nakshatra, moonSign: p.moonSign, weekday: p.weekday });
const pretty = `${WEEKDAYS[p.weekday]}, ${ymd.d} ${['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'][ymd.m - 1]} ${ymd.y}`;
const star = (n: number) => '★'.repeat(n) + '☆'.repeat(5 - n);
const readings = RASHIS.map((r, i) => ({ r, d: reading(i, ymd, 'daily') }));
---
<Base title="Rasi Phalalu Today: Daily, Weekly, Monthly Horoscope for Every Rashi" description="Today's rasi phalalu for all twelve rashis, plus weekly and monthly horoscopes, worked out from the day's real planetary positions." active="astrology" breadcrumbs={[{ name: 'Rasi Phalalu', href: '/rasi-phalalu/' }]} image="/covers/rasi-phalalu.png">
  <div class="page wide c-astrology">
    <div class="kicker">Rasi Phalalu</div>
    <h1>Today's rasi phalalu</h1>
    <p class="meta" style="margin:0 0 6px">{pretty}</p>
    <Hero name="zodiac-wheel" alt="A zodiac wheel with twelve constellations around the sun and moon on a night sky" />
    <div class="sect"><h2>Overall for the day</h2></div>
    <div class="rcard" style="margin-bottom:34px"><b>{o.headline}</b><ul style="margin:0;padding-left:20px;font-family:var(--serif);font-size:17.5px;line-height:1.6">{o.points.map((x) => <li style="margin:6px 0">{x}</li>)}</ul></div>
    <div class="sect"><h2>Choose your rashi</h2></div>
    <p class="sub" style="margin-top:-6px">Your rashi is the sign your Moon was in at birth. Not sure? Check your janma rashi on your horoscope, or ask your family.</p>
    <div class="sign-grid">
      {readings.map(({ r, d }) => (
        <a class="sign-card" href={`/rasi-phalalu/${r.id}/`}>
          <Glyph id={r.id} size={38} />
          <h3>{r.skt} <span class="te">{r.te}</span></h3>
          <div class="sub">{r.en}</div>
          <div class="stars" aria-label={`${d.rating} of 5`}>{star(d.rating)}</div>
        </a>
      ))}
    </div>
    <p class="disc">Rashi phalalu on Southwala are for entertainment and reflection. They are worked out from the day's planetary positions using the traditional Vedic gochara (transit) rules, the same for everyone born under a rashi. They are not predictions about your life and not a substitute for medical, legal or financial advice.</p>
  </div>
</Base>
