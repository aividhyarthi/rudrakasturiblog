---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { REGIONS, SITE } from '../../../config';
export async function getStaticPaths() {
  const all = await getCollection('temples');
  return all.map((t) => ({ params: { slug: t.slug }, props: { t } }));
}
const { t } = Astro.props;
const { Content } = await t.render();
const d = t.data;
const jsonLd = { '@context': 'https://schema.org', '@type': 'HinduTemple', name: d.name, address: { '@type': 'PostalAddress', addressLocality: d.place, addressRegion: REGIONS[d.state], addressCountry: 'IN' }, url: `${SITE.url}/religion/temples/${t.slug}/` };
---
<Base title={d.name} description={d.summary} jsonLd={jsonLd} active="religion">
  <div class="page" style="max-width:800px">
    <div class="kicker"><a href="/religion/">Religion</a> &nbsp;/&nbsp; <a href="/religion/temples/">Temples</a></div>
    <h1>{d.name}</h1>
    <p class="te" style="margin:0">{d.te}</p>
    <p class="dek" style="margin-top:10px">{d.summary}</p>
    <table class="data">
      <tbody>
        <tr><th>Place</th><td>{d.place}</td></tr>
        <tr><th>District, state</th><td>{d.district}, {REGIONS[d.state]}</td></tr>
        <tr><th>Deity</th><td>{d.deity}</td></tr>
        {d.festivals.length > 0 && <tr><th>Major festivals</th><td>{d.festivals.join('; ')}</td></tr>}
      </tbody>
    </table>
    <div class="body"><Content /></div>
    {d.sources.length > 0 && <div class="note"><h4>Sources</h4><ul>{d.sources.map((s) => <li><a href={s.url} rel="noopener nofollow" target="_blank">{s.title}</a>, {s.publisher}</li>)}</ul></div>}
    <div class="note"><h4>Corrections</h4>Spotted something out of date? Write to {SITE.email} and we will fix it.</div>
  </div>
</Base>
