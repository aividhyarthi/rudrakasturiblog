---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { REGIONS } from '../../../config';
const temples = (await getCollection('temples')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const states = ['ap', 'ts', 'ka', 'tn', 'kl'] as const;
---
<Base title="Temples of Andhra Pradesh and Telangana" description="Guides to major temples: significance, history, festivals and what to know before you visit." active="religion">
  <div class="page" style="max-width:860px">
    <div class="kicker"><a href="/religion/">Religion</a></div>
    <h1>Temples</h1>
    <p class="dek">Guides to major temples of the South: what they are known for, their history as recorded, festivals, and what to check before you visit.</p>
    {states.map((s) => {
      const list = temples.filter((t) => t.data.state === s);
      return list.length ? (
        <>
          <div class="sechead" style="margin-top:24px"><h2>{REGIONS[s]}</h2></div>
          {list.map((t) => (
            <a class="item" href={`/religion/temples/${t.slug}/`}>
              <h3>{t.data.name} <span class="te">{t.data.te}</span></h3>
              <p>{t.data.summary}</p>
              <div class="meta" style="margin-top:3px">{t.data.place}, {t.data.district}</div>
            </a>
          ))}
        </>
      ) : null;
    })}
  </div>
</Base>
