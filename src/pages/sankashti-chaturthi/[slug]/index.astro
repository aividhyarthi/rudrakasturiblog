---
import TithiPage from '../../../components/TithiPage.astro';
import { permaPages } from '../../../lib/perma';
export function getStaticPaths() { return permaPages('sankashti').map((p) => ({ params: { slug: p.slug }, props: { l: p.primary, group: p.group } })); }
const { l, group } = Astro.props;
---
<TithiPage l={l} group={group} />
