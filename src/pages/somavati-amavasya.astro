---
// One permanent page for Somavati Amavasya (an Amavasya that falls on a Monday). It always shows the next date,
// switches to a "today" view on the day, and is rebuilt every India day by the daily rebuild.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import MasaBanner from '../components/MasaBanner.astro';
import { panchangFor, fmtTime, todayIST, ymdKey, WEEKDAYS, istParts } from '../lib/panchang';
import { MONTHS, MONTHS_TE, EN_MONTH_NAMES } from '../lib/lunar';
import { allSomavati, nextSomavati } from '../lib/somavati';
import { allArticles } from '../lib/articles';
const published = new Set((await allArticles()).map((a) => a.slug));
const hasAncestors = published.has('how-to-honour-ancestors-pitru-mantras-and-family-peace');
const today = todayIST(), tk = ymdKey(today);
const n = nextSomavati(today)!;
const ymd = n.ymd;
const p = panchangFor(ymd, 'hyderabad');
const ref = new Date(Date.UTC(ymd.y, ymd.m - 1, ymd.d));
const t = (d: Date) => fmtTime(d, ref);
// tithi times are rounded to the nearest minute (12:31:58 reads 12:32), not cut off
const rnd = (d: Date) => new Date(Math.round(d.getTime() / 60000) * 60000);
const dt = (d: Date) => { const r = rnd(d); const x = istParts(r); return `${WEEKDAYS[x.getUTCDay()].slice(0, 3)}, ${x.getUTCDate()} ${EN_MONTH_NAMES[x.getUTCMonth()]}, ${fmtTime(r)}`; };
const dayOf = (d: Date) => { const x = istParts(d); return `${WEEKDAYS[x.getUTCDay()]} ${x.getUTCDate()} ${EN_MONTH_NAMES[x.getUTCMonth()]}`; };
const mName = EN_MONTH_NAMES[ymd.m - 1];
const pretty = `${WEEKDAYS[1]}, ${ymd.d} ${mName} ${ymd.y}`;
const short = `${ymd.d} ${mName}`;
const diff = Math.round((Date.UTC(ymd.y, ymd.m - 1, ymd.d) - Date.UTC(today.y, today.m - 1, today.d)) / 86400000);
const isToday = diff === 0, soon = diff > 0 && diff <= 3;
const month = `${n.adhika ? 'Adhika ' : ''}${MONTHS[n.month]}`;
const startDay = dayOf(n.start), endDay = dayOf(n.end);
const startsEarlier = startDay !== `${WEEKDAYS[1]} ${ymd.d} ${mName}`;
const upcoming = allSomavati().filter((s) => s.key >= tk).slice(0, 6);
const nakAtRise = p.nakshatra[0];
const lead = isToday ? 'Today' : diff === 1 ? 'Tomorrow' : soon ? `In ${diff} days` : 'Next';
const title = `Somavati Amavasya ${ymd.y}: ${WEEKDAYS[1]} ${short}, Timings, Puja and the Story`;
const desc = `${isToday ? 'Today, ' : ''}Somavati Amavasya ${isToday ? 'is' : 'falls'} on ${pretty}. Amavasya begins ${dt(n.start)} and ends ${dt(n.end)} (IST). Puja at home, the peepal parikrama and the story.`;
const deepavali = n.month === 6 && !n.adhika;
const faq: [string, string][] = [
  [`When is Somavati Amavasya in ${ymd.y}?`, `On ${pretty}. Amavasya begins ${dt(n.start)} and ends ${dt(n.end)} (IST). ${n.basis === 'sunrise' ? 'It is the tithi at sunrise on the Monday.' : 'It is present in the Monday afternoon.'}`],
  ['What is Somavati Amavasya?', 'The new moon (Amavasya) that falls on a Monday (Somavara), Shiva\'s day. Amavasya is the day tradition keeps for the ancestors, so a Monday Amavasya combines worship of Shiva with remembrance of the family that came before.'],
  [`Is the Amavasya on ${startDay} or ${endDay}?`, `The tithi begins on ${startDay} and ends on ${endDay}. Calendars choose the day by rule. Many count the tithi at sunrise, which makes it the Monday. Others count the day when it is present in the afternoon. Keep to your family's rule, and ask your priest if unsure.`],
  ['Why is Somavati Amavasya special?', 'Monday is Shiva\'s day and Amavasya is the day of the ancestors. When they meet, both are honoured on one day. It happens only a few times a year, and some years only once.'],
  ['Who can keep the Somavati Amavasya vrat?', 'In North Indian custom it is best known as a vrat for married women. In many families unmarried girls, men and elders also keep the day for Shiva and for the ancestors.'],
  ['How many times do you go around the peepal tree?', 'The traditional number is 108 rounds, with a fruit, flower or grain offered at each round. If that is too many, families do fewer, such as 7 or 21, with the same devotion.'],
  ['What if there is no peepal tree nearby?', 'Worship Shiva and Parvati at home, or at a nearby Shiva temple, and keep the same prayer in mind. The peepal is a custom, not a condition.'],
  ['What should be donated on Somavati Amavasya?', 'Food, grain, clothes and black sesame are the usual gifts. Many families feed the hungry or give to a temple kitchen in the name of departed elders.'],
  ['Should I fast?', 'Only if it suits your health. Many keep a fast until the puja and end it with fruit or a simple vegetarian meal. Children, the elderly, pregnant women and anyone unwell should not fast strictly.'],
  ['When is the next Somavati Amavasya after this one?', upcoming[1] ? `${upcoming[1].ymd.d} ${EN_MONTH_NAMES[upcoming[1].ymd.m - 1]} ${upcoming[1].ymd.y}, a Monday.` : 'See the dates table on this page.'],
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
---
<Base rail="religion" title={title} description={desc} active="religion" breadcrumbs={[{ name: 'Devotional', href: '/religion/' }, { name: 'Amavasya', href: '/amavasya/' }, { name: 'Somavati Amavasya', href: '/somavati-amavasya/' }]} image="/covers/somavati-amavasya.png">
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <div class="page wide c-religion">
    <div class="kicker"><a href="/amavasya/">Amavasya <span class="te">అమావాస్య</span></a></div>
    <h1>Somavati Amavasya <span class="te">సోమవతి అమావాస్య</span> {ymd.y}: {pretty}</h1>
    <p class="dek" style="margin:0 0 6px">{isToday ? 'Today is Somavati Amavasya: the new moon on Shiva\'s day.' : soon ? `Somavati Amavasya is ${diff === 1 ? 'tomorrow' : `in ${diff} days`}: the new moon on Shiva's day.` : 'The new moon that falls on a Monday, Shiva\'s day.'}</p>
    <Hero name="shiva-symbols" alt="A Shiva lingam with a lamp, a small pot of water and bilva leaves" ratio="16/5" />
    <p class="sub"><b>Source:</b> Hindu tradition and later folk practice. The Somavati Amavasya katha is a folk story told in many versions, and customs differ between regions and families. For the rites, please follow your own family elders or priest.</p>

    <div class="sect"><h2>{lead}: Somavati Amavasya at a glance</h2></div>
    <div class="pgrid">
      <div class="pcard"><b>Day</b><span>{pretty}</span></div>
      <div class="pcard"><b>Amavasya begins</b><span>{dt(n.start)}</span></div>
      <div class="pcard"><b>Amavasya ends</b><span>{dt(n.end)}</span></div>
      <div class="pcard"><b>Lunar month</b><span>{month} ({MONTHS_TE[n.month]})</span></div>
    </div>
    <div class="timing">
      <div class="good"><b>Good timings (Hyderabad)</b><span>{t(p.brahma.start)} to {t(p.brahma.end)}</span><small>Brahma Muhurtham</small><span style="display:block;margin-top:14px">{t(p.abhijit.start)} to {t(p.abhijit.end)}</span><small>Abhijit Muhurtham</small></div>
      <div class="bad"><b>Timings to avoid</b><span>{t(p.rahu.start)} to {t(p.rahu.end)}</span><small>Rahu Kalam on the Monday</small><span style="display:block;margin-top:14px;font-size:18px">Sunrise {t(p.sunrise)}, sunset {t(p.sunset)}</span></div>
    </div>
    <p class="sub">Best time for the bath, tarpanam and puja: from sunrise ({t(p.sunrise)}) until the tithi ends ({dt(n.end)}). The nakshatra at sunrise is {nakAtRise.name}. Tithi times are the same across India; sunrise-based timings shift by a few minutes between cities. For your city see <a href="/panchangam/" style="text-decoration:underline">today's panchangam</a>.</p>

    {(isToday || soon) && <MasaBanner ymd={today} compact />}

    <div class="sect"><h2>Is Amavasya on {startDay} or {endDay}?</h2></div>
    {startsEarlier ? (
      <>
        <p>You may see both dates, and both are right. They answer different questions. The Amavasya tithi begins on <b>{dt(n.start)}</b> and ends on <b>{dt(n.end)}</b> (IST).</p>
        <ul>
          <li><b>The evening of {startDay}.</b> The tithi is already running at dusk{deepavali ? ', on the evening of Deepavali and Lakshmi Puja, which is why many calendars name that day for Amavasya' : ', which is why some calendars name that day for Amavasya'}.</li>
          <li><b>The morning of {endDay}.</b> The tithi is still running at sunrise and ends at {fmtTime(rnd(n.end), ref)}. The morning bath, tarpanam for the ancestors and the Somavati observances are done on this day, within those hours.</li>
        </ul>
        <p>On our <a href="/amavasya/" style="text-decoration:underline">Amavasya dates</a> pages we take the day when the tithi is present in the afternoon, and many families and temples count the sunrise tithi instead. If your family follows a fixed rule, keep to it.</p>
      </>
    ) : (
      <p>This year the tithi begins on <b>{dt(n.start)}</b> and ends on <b>{dt(n.end)}</b> (IST), so it falls within the one Monday. Many calendars count the day by the tithi at sunrise, others by the afternoon. Here the Monday is the answer either way. If your family follows a different rule, keep to it.</p>
    )}
    {deepavali && <p>This Amavasya closes <b>Ashwayuja masam</b>, the month of Deepavali. <a href="/karthika-masam-2026-dates-deepam-and-fasting/" style="text-decoration:underline">Karthika Masam</a> begins with the next sunrise, and its four Mondays, <a href="/karthika-somavaram-the-monday-fast-and-the-worship-of-shiva/" style="text-decoration:underline">Karthika Somavaram</a>, are among the most important Shiva days of the year.</p>}

    <div class="sect"><h2>What Somavati Amavasya means</h2></div>
    <p><i>Soma</i> means the Moon. It is also a name used for Shiva, who wears the crescent. <i>Vara</i> means day, and Monday is <i>Somavara</i>, the day of the Moon and of Shiva. Amavasya, the new moon, is the day that tradition keeps for the ancestors. So a Monday Amavasya brings two things together: worship of Shiva, and remembrance of the family that came before. It comes only a few times a year, and in some years only once, which is why families plan for it.</p>
    <p>It also has a gentle mood. Many teachers say the new moon is not unlucky in itself. It is a day for turning inward, for prayer and silence rather than celebration.</p>

    <div class="sect"><h2>Who keeps the vrat</h2></div>
    <p>In North India, Somavati Amavasya is best known as a vrat for married women, who fast and worship the peepal tree for the long life and health of their husbands and family. It is close in spirit to Vat Savitri, where the banyan is worshipped for the same prayer.</p>
    <p>In many families other people keep the day too: unmarried girls, men and elders, for Shiva and for the ancestors. In the Telugu and Tamil country the peepal custom is less common, and the day is more often kept with Shiva worship, a bath, tarpanam and charity. Neither way is more correct than the other.</p>

    <div class="sect"><h2>The story of Somavati Amavasya</h2></div>
    <p>This is a folk story, told with small differences from village to village. Some tellings say it was told by Bhishma to Yudhishthira after the war. We have not found a standard text for that, so we mention it only as the way the story is often introduced.</p>
    <p>In the usual telling, a young woman from a respected family was told by a sage that her fate held no marriage, or in some versions that she would be widowed. Troubled, she went to a poor washerwoman called Soma, and began to serve her in secret. Every morning, before the household woke, the girl did the old woman's chores for her.</p>
    <p>When Soma discovered who had been helping her, she was deeply moved, and she gave the girl her blessing as a married woman. In one telling the blessing cost Soma her own husband. With nothing else to offer, she went to the peepal tree she worshipped every day and walked around it 108 times, and her husband came back to life. Married women repeat her parikrama on this day.</p>
    <p>Whatever you make of the details, the heart of the story is clear. The girl served without being asked and without being seen. The washerwoman gave what she had. In both, devotion and kindness do what power cannot.</p>

    <div class="sect"><h2>How to do the puja at home</h2></div>
    <p>Follow your family's custom first. This is a simple, common outline.</p>
    <ol>
      <li><b>Bathe before sunrise.</b> Bathe in a river if you can, or at home with a few drops of Ganga water or a little sesame in the water.</li>
      <li><b>Offer water to the rising Sun.</b> Stand facing east and pour water from a copper or brass lota.</li>
      <li><b>Take a sankalp.</b> At your home shrine, say your name and your prayer for the day: for the family, for someone unwell, or for the peace of the ancestors.</li>
      <li><b>Worship Shiva.</b> Offer water or milk and bilva leaves to a Shivalinga at home or at a temple, and chant <i>Om Namah Shivaya</i>. Monday is his day.</li>
      <li><b>Light a lamp.</b> A ghee or sesame oil lamp at the shrine, and another at the doorstep at dusk.</li>
      <li><b>Worship the peepal tree if you can.</b> At the foot of the tree offer water, a little raw milk, kumkum, sandalwood, rice and flowers. Walk around it, winding a cotton thread or red and yellow moli round the trunk. The custom is 108 rounds. If that is too many, do what you can, with devotion.</li>
      <li><b>Remember the ancestors.</b> If your father is no longer living, offer water with black sesame (tarpanam) in the way your family does it. Many families set aside some food for crows before they eat.</li>
      <li><b>Give.</b> Share food, grain or clothes with someone in need, or give to a temple kitchen. Married women often give bangles and bindi to other women.</li>
      <li><b>Break the fast.</b> After the puja, with fruit or a simple vegetarian meal. Children, the elderly, pregnant women and anyone unwell should eat normally and keep the day through prayer and charity.</li>
    </ol>
    {hasAncestors && <p>For the ancestors' side of the day, see <a href="/how-to-honour-ancestors-pitru-mantras-and-family-peace/" style="text-decoration:underline">how to honour ancestors</a>.</p>}

    <div class="sect"><h2>What to keep ready (samagri)</h2></div>
    <ul>
      <li>A copper or brass lota and clean water, and a few drops of Ganga water if you have it</li>
      <li>Milk, kumkum and sandalwood paste</li>
      <li>Akshat (unbroken rice) and flowers</li>
      <li>Black sesame (til)</li>
      <li>Raw cotton thread or red and yellow moli</li>
      <li>Fruits, flowers or sweets, if you will do the peepal rounds</li>
      <li>A ghee or oil lamp with wicks, and incense</li>
      <li>Bilva leaves for Shiva</li>
      <li>Bangles and bindi, if you will give suhaag daan</li>
      <li>Grain, clothes or food for charity</li>
    </ul>

    <div class="sect"><h2>The peepal tree</h2></div>
    <p>The peepal, or <i>ashvattha</i>, is one of the most honoured trees in India. In the Bhagavad Gita Krishna says "of all trees I am the ashvattha" (10.26), and in chapter 15 he uses the picture of an ashvattha with its roots above and branches below to describe the world. Many people worship it as a dwelling of the three great gods.</p>
    <p>If you go to a peepal tree, choose one at a temple or a clean public place, and go in the morning. Pour the water and milk at the root. Light your lamp on the ground, away from the bark and dry leaves. As you walk, let the thread unwind round the trunk, round by round. To keep count, set aside one grain or flower at each round.</p>

    <div class="sect"><h2>How the day is kept in different places</h2></div>
    <ul>
      <li><b>Haridwar, Varanasi and Prayag.</b> Large crowds bathe in the Ganga from the early morning, and offer tarpan and charity on the bank.</li>
      <li><b>North India generally.</b> Married women gather at a neighbourhood peepal or a temple courtyard, wind thread round the trunk and listen to the katha together.</li>
      <li><b>The Telugu and Tamil country.</b> Monday is kept for Shiva with abhishekam and bilva leaves. Many families offer tarpanam and give food, often at a river, a tank or the sea. Many people also go to a Shiva temple after the bath.</li>
    </ul>
    <p>For ordinary Mondays, see <a href="/monday-shiva-worship-panchakshari-and-pournami/" style="text-decoration:underline">Monday Shiva worship</a>.</p>

    <div class="sect"><h2>What many families avoid on Amavasya</h2></div>
    <ul>
      <li>Starting a new business, a wedding or a house-warming</li>
      <li>Cutting hair, shaving or cutting nails</li>
      <li>Non-vegetarian food</li>
      <li>Lending or borrowing money</li>
      <li>Quarrels and harsh words at home</li>
    </ul>
    <p>These are traditional customs and they vary by family. Most teachers add that the new moon is not a day to fear. It is a day to slow down.</p>

    <div class="sect"><h2>Somavati Amavasya dates</h2></div>
    <table>
      <thead><tr><th>Day</th><th>Date</th><th>Amavasya tithi (IST)</th></tr></thead>
      <tbody>{upcoming.map((s) => <tr><td>Monday</td><td>{s.ymd.d} {EN_MONTH_NAMES[s.ymd.m - 1]} {s.ymd.y}</td><td>{dt(s.start)} to {dt(s.end)}</td></tr>)}</tbody>
    </table>
    <p class="sub">Dates are calculated from the Sun and Moon (Lahiri ayanamsa) for Hyderabad. For every Amavasya of the year, see our <a href="/amavasya/" style="text-decoration:underline">Amavasya dates</a>.</p>

    <div class="sect"><h2>Questions people ask</h2></div>
    {faq.map(([q, a]) => <><h3 style="margin-bottom:2px">{q}</h3><p style="margin-top:0">{a}</p></>)}

    <div class="sect"><h2>One question for you</h2></div>
    <p>How does your family keep this day? Did your grandmother tell the washerwoman's story, or do you go to a river or a Shiva temple? We would like to hear it. Write to us at hello@southwala.com.</p>
    <p class="disc">Calculated from the astronomical positions of the Sun and Moon. Traditions vary by region and family. For rituals, confirm the day with your family priest or temple.</p>
  </div>
</Base>
