---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import Sidebar from '../../components/Sidebar.astro';
import { allArticles } from '../../lib/articles';
import { REGIONS } from '../../config';
export function getStaticPaths() { return ['ap', 'ts', 'ka', 'tn', 'kl'].map((s) => ({ params: { state: s } })); }
const { state } = Astro.params;
const label = REGIONS[state as 'ap' | 'ts' | 'ka' | 'tn' | 'kl'];
const items = (await allArticles()).filter((a) => a.data.region === state);
---
<Base title={`${label} news`} description={`Politics, cinema and more from ${label}, with the receipts.`}>
  <div class="art">
    <div>
      <div class="sechead"><h2>{label}</h2></div>
      {items.length ? <div>{items.map((a) => <Card a={a} />)}</div> : <div class="empty">No {label} stories yet. Check back soon.</div>}
    </div>
    <Sidebar />
  </div>
</Base>
