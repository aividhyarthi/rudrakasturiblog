---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
const desks = [
  ['Devotional Desk', 'Panchangam, festivals, vratams, mantras and temple guides.'],
  ['Astrology Desk', 'Daily, weekly and monthly rasi phalalu, planets and rashis.'],
  ['Gita Desk', 'The Bhagavad Gita chapter by chapter, and karma stories from the epics.'],
  ['Temples Desk', 'Temple guides, history and visiting notes, with a focus on Tamil Nadu and the Telugu states.'],
  ['Dharma Desk', 'Advaita, Adi Shankaracharya, the Upanishads, Sanatana Dharma and faith stories.'],
  ['Yoga Desk', 'Yoga, pranayama and simple practices for daily life.'],
  ['News Desk', 'Politics, cinema and OTT from the five southern states.'],
];
---
<Base title="Our desks" description="The Southwala desks: devotional, astrology, Gita, yoga and news, and what each covers.">
  <div class="page">
    <h1>Our desks</h1>
    <p>Southwala articles are published under the name of the desk that covers the topic. Every article follows our <a href="/editorial-policy/">editorial policy</a>. To suggest a topic or request a correction, write to <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
    <ul>{desks.map(([n, d]) => <li><b>Southwala {n}</b>: {d}</li>)}</ul>
  </div>
</Base>
