---
import Hero from '../../components/Hero.astro';
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { REGIONS, SITE } from '../../config';
import { LISTS } from '../../data/temple-lists';
export async function getStaticPaths() {
  const all = await getCollection('temples');
  const paths: any[] = all.map((t) => ({ params: { slug: t.slug }, props: { type: 'temple', t } }));
  LISTS.forEach((l) => paths.push({ params: { slug: l.slug }, props: { type: 'list', l } }));
  paths.push({ params: { slug: 'god-temples' }, props: { type: 'kind', kind: 'god' } });
  paths.push({ params: { slug: 'goddess-temples' }, props: { type: 'kind', kind: 'goddess' } });
  return paths;
}
const props = Astro.props as any;
const all = (await getCollection('temples')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const nameBySlug: Record<string, string> = Object.fromEntries(all.map((t) => [t.slug, t.data.name]));
const slug = Astro.params.slug as string;
const url = `${SITE.url}/temples/${slug}/`;
const base = [{ name: 'Religion', href: '/religion/' }, { name: 'Temples', href: '/temples/' }];

let title = '', description = '', h1 = '', crumbs = base, jsonLd: any = undefined, Content: any = null, faq: [string, string][] = [];
if (props.type === 'temple') {
  const d = props.t.data;
  Content = (await props.t.render()).Content;
  title = d.name; description = d.summary; h1 = d.name;
  crumbs = [...base, { name: d.name, href: `/temples/${slug}/` }];
  jsonLd = { '@context': 'https://schema.org', '@type': 'HinduTemple', name: d.name, description: d.summary, url, address: { '@type': 'PostalAddress', addressLocality: d.place, addressRegion: REGIONS[d.state as keyof typeof REGIONS], addressCountry: 'IN' } };
} else if (props.type === 'list') {
  const l = props.l;
  title = l.title; description = l.description; h1 = l.h1; faq = l.faq ?? [];
  crumbs = [...base, { name: l.h1, href: `/temples/${slug}/` }];
  jsonLd = { '@context': 'https://schema.org', '@type': 'ItemList', name: l.h1, itemListElement: l.entries.map((e: any, i: number) => ({ '@type': 'ListItem', position: i + 1, name: `${e.name}, ${e.place}, ${e.state}` })) };
} else {
  const goddess = props.kind === 'goddess';
  title = goddess ? 'Goddess Temples of India: Shakti Peethas and Devi Temples' : 'God Temples of India: Shiva, Vishnu and Rama Temples';
  description = goddess ? 'Guides and lists of the most important Devi and Shakti temples of India.' : 'Guides and lists of the most important Shiva, Vishnu and Rama temples of India.';
  h1 = goddess ? 'Goddess temples of India' : 'God temples of India';
  crumbs = [...base, { name: h1, href: `/temples/${slug}/` }];
}
const lists = LISTS.filter((l) => (props.type === 'kind' ? (props.kind === 'goddess' ? l.kind === 'goddess' || l.kind === 'mixed' : l.kind === 'god' || l.kind === 'mixed') : false));
const guides = props.type === 'kind' ? all.filter((t) => t.data.kind === props.kind || t.data.kind === 'both') : [];
const faqLd = faq.length ? { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) } : null;
const LIST_HERO: Record<string, string> = { jyotirlingas: 'jyotirlinga-dawn', 'char-dham': 'vishnu-symbols', 'pancharama-kshetralu': 'shiva-symbols', 'pancha-bhoota-sthalams': 'shiva-symbols', 'shakti-peethas': 'goddess-temple', 'god-temples': 'shiva-symbols', 'goddess-temples': 'devi-symbols' };
const heroName = props.type === 'temple' ? (props.t.data.hero ?? 'temple-sunrise') : (LIST_HERO[slug] ?? 'temple-sunrise');
const imageSlug = props.type === 'temple' ? `t-${slug}` : 'temples';
---
<Base rail="religion" title={title} description={description} jsonLd={jsonLd} active="temples" breadcrumbs={crumbs} image={`/covers/${imageSlug}.png`}>
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
  <div class="page c-religion">
    <div class="kicker"><a href="/religion/">Religion</a> &nbsp;/&nbsp; <a href="/temples/">Temples</a></div>
    <h1>{h1}</h1>
    <Hero name={heroName} alt={`Illustration for ${h1}`} />

    {props.type === 'temple' && (<>
      <p class="te" style="margin:0">{props.t.data.te}</p>
      <p class="dek" style="margin-top:10px">{props.t.data.summary}</p>
      <table class="data"><tbody>
        <tr><th>Place</th><td>{props.t.data.place}</td></tr>
        <tr><th>District, state</th><td>{props.t.data.district}, {REGIONS[props.t.data.state as keyof typeof REGIONS]}</td></tr>
        <tr><th>Deity</th><td>{props.t.data.deity}</td></tr>
        {props.t.data.festivals.length > 0 && <tr><th>Major festivals</th><td>{props.t.data.festivals.join('; ')}</td></tr>}
      </tbody></table>
      <div class="prose"><Content /></div>
      {props.t.data.sources.length > 0 && <div class="note"><h4>Sources</h4><ul>{props.t.data.sources.map((s: any) => <li><a href={s.url} rel="noopener nofollow" target="_blank">{s.title}</a>, {s.publisher}</li>)}</ul></div>}
      <div class="note"><h4>Corrections</h4>Spotted something out of date? Write to {SITE.email} and we will fix it.</div>
    </>)}

    {props.type === 'list' && (<>
      {props.l.intro.map((p: string) => <p class="dek" style="font-size:18px">{p}</p>)}
      <table class="data">
        <thead><tr><th style="width:6%">#</th><th>Temple</th><th style="width:34%">Where</th></tr></thead>
        <tbody>
          {props.l.entries.map((e: any, i: number) => (
            <tr>
              <td>{i + 1}</td>
              <td>{e.slug ? <a href={`/temples/${e.slug}/`} style="text-decoration:underline"><b>{e.name}</b></a> : <b>{e.name}</b>}<div class="sub">{[e.deity !== e.name ? e.deity : '', e.note ?? ''].filter(Boolean).join('. ')}</div></td>
              <td>{e.place}, {e.state}</td>
            </tr>
          ))}
        </tbody>
      </table>
      {faq.length > 0 && (<><div class="sect"><h2>Common questions</h2></div>{faq.map(([q, a]) => <><h3 style="margin-bottom:2px">{q}</h3><p style="margin-top:0">{a}</p></>)}</>)}
      <div class="chips" style="margin-top:18px"><a href="/temples/">All temple lists</a>{LISTS.filter((x) => x.slug !== slug).map((x) => <a href={`/temples/${x.slug}/`}>{x.h1}</a>)}</div>
      <p class="disc">Lists in this tradition are not fixed by any authority, and sources differ on some details. We give the most widely accepted version and flag disputed points. For timings and rules, check each temple's official channels.</p>
    </>)}

    {props.type === 'kind' && (<>
      <p class="dek" style="font-size:18px">{description}</p>
      <div class="sect"><h2>Lists</h2></div>
      {lists.map((l) => <a class="item" href={`/temples/${l.slug}/`}><h3>{l.h1}</h3><p>{l.description}</p></a>)}
      <div class="sect" style="margin-top:20px"><h2>Temple guides</h2></div>
      {guides.map((t) => <a class="item" href={`/temples/${t.slug}/`}><h3>{t.data.name}</h3><p>{t.data.summary}</p></a>)}
    </>)}
  </div>
</Base>
