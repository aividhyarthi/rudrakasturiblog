---
import Hero from '../../components/Hero.astro';
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { REGIONS } from '../../config';
import { LISTS } from '../../data/temple-lists';
const temples = (await getCollection('temples')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const states = ['ap', 'ts', 'ka', 'tn', 'kl'] as const;
const crumbs = [{ name: 'Religion', href: '/religion/' }, { name: 'Temples', href: '/temples/' }];
---
<Base title="Temples of India: Jyotirlingas, Shakti Peethas, Char Dham and More" description="Guides and complete lists of India's most important temples: the 12 Jyotirlingas, 18 Maha Shakti Peethas, Char Dham, Pancharama Kshetralu and more, with history, festivals and what to know before you visit." active="religion" breadcrumbs={crumbs} image="/covers/temples.png">
  <div class="page" style="max-width:860px">
    <div class="kicker"><a href="/religion/">Religion</a></div>
    <h1>Temples of India</h1>
    <Hero name="temple-sunrise" alt="A South Indian temple gopuram at sunrise with a row of lit oil lamps" />
    <p class="dek">Complete lists of the temples every pilgrim asks about, and detailed guides to major temples, with history, festivals and what to check before you go.</p>
    <div class="chips" style="margin:6px 0 4px"><a href="/temples/god-temples/">God temples</a><a href="/temples/goddess-temples/">Goddess temples</a></div>
    <div class="sechead" style="margin-top:24px"><h2>Complete lists</h2></div>
    {LISTS.map((l) => (
      <a class="item" href={`/temples/${l.slug}/`}><h3>{l.h1}</h3><p>{l.description}</p></a>
    ))}
    <div class="sechead" style="margin-top:24px"><h2>Temple guides</h2></div>
    {states.map((s) => {
      const list = temples.filter((t) => t.data.state === s);
      return list.length ? (
        <>
          <div class="meta" style="margin:14px 0 4px;font-weight:700;text-transform:uppercase;letter-spacing:.8px">{REGIONS[s]}</div>
          {list.map((t) => (
            <a class="item" href={`/temples/${t.slug}/`}>
              <h3>{t.data.name} <span class="te">{t.data.te}</span></h3>
              <p>{t.data.summary}</p>
              <div class="meta" style="margin-top:3px">{t.data.place}, {t.data.district}</div>
            </a>
          ))}
        </>
      ) : null;
    })}
  </div>
</Base>
